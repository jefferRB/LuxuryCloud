@{
    Layout = null;
    ViewData["Title"] = "Comprobante no disponible";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <style>
        body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
               background:#f1f1f3; font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; padding:24px; }
        .card { background:#fff; border-radius:14px; box-shadow:0 6px 24px rgba(0,0,0,.08);
                padding:36px 32px; max-width:420px; text-align:center; }
        h1 { font-size:20px; margin:0 0 8px; color:#111; }
        p { color:#666; font-size:14px; line-height:1.6; margin:0; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Comprobante no disponible</h1>
        <p>El enlace no es válido o el comprobante ya no está disponible. Si necesitas una copia,
           solicítala directamente al negocio que te atendió.</p>
    </div>
</body>
</html>
