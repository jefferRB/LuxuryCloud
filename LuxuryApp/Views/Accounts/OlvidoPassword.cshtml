@model LuxuryApp.Models.Identity.OlvidoPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["PublicBodyClass"] = "public-auth-page";
    Layout = "_PublicLayout";
}

<section class="auth-section">
    <div class="container forgot-shell">
        <div class="forgot-card" data-aos="fade-up">

            <div class="forgot-form-panel">
                <span class="section-kicker">Recuperar acceso</span>
                <h2>Recuperar contraseña</h2>
                <p>
                    Ingresa el correo electrónico asociado a tu cuenta y te enviaremos un enlace seguro para restablecer tu contraseña.
                </p>

                <form asp-controller="Accounts" asp-action="OlvidoPassword" method="post" data-prevent-double-submit>
                    @Html.AntiForgeryToken()

                    <div class="text-danger auth-validation mb-3" asp-validation-summary="All"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label">Correo electrónico</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input asp-for="Email" class="form-control public-form-control" placeholder="correo@negocio.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn public-btn public-btn-primary w-100">
                        <span class="auth-submit-arrow">Enviar enlace de recuperación <i class="bi bi-arrow-right"></i></span>
                    </button>

                    <a asp-action="Acceso" class="auth-back-link">
                        <i class="bi bi-arrow-left"></i> Volver a iniciar sesión
                    </a>
                </form>
            </div>

            <div class="forgot-security-panel">
                <div class="forgot-security-shield">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3 class="forgot-security-title">Tu seguridad es nuestra prioridad</h3>

                <ul class="forgot-security-items">
                    <li class="forgot-security-item">
                        <span class="forgot-security-item-icon"><i class="bi bi-shield-check"></i></span>
                        <div>
                            <strong>Proceso seguro</strong>
                            <span>Generamos un enlace único y encriptado para proteger tu cuenta.</span>
                        </div>
                    </li>
                    <li class="forgot-security-item">
                        <span class="forgot-security-item-icon"><i class="bi bi-envelope-check"></i></span>
                        <div>
                            <strong>Solo para tu correo registrado</strong>
                            <span>El enlace de recuperación será enviado únicamente al correo asociado a tu cuenta.</span>
                        </div>
                    </li>
                    <li class="forgot-security-item">
                        <span class="forgot-security-item-icon"><i class="bi bi-clock"></i></span>
                        <div>
                            <strong>Rápido y sencillo</strong>
                            <span>Recupera el acceso a tu cuenta en pocos minutos.</span>
                        </div>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
