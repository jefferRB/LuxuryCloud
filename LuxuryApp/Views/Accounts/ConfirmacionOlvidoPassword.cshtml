@{
    ViewData["Title"] = "Enlace enviado";
    ViewData["PublicBodyClass"] = "public-auth-page";
    Layout = "_PublicLayout";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5" data-aos="fade-up">
                <div class="auth-form-card text-center">
                    <i class="bi bi-envelope-check fs-1 mb-3 d-block"></i>
                    <span class="section-kicker">Solicitud enviada</span>
                    <h2>Revisa tu correo</h2>
                    <p class="text-muted mb-3">
                        Si el correo ingresado está registrado en LuxuryCloud, recibirás un enlace
                        para restablecer tu contraseña en los próximos minutos.
                    </p>
                    <p class="text-muted small mb-4">
                        Revisa también la carpeta de spam o correo no deseado.
                    </p>
                    <a asp-controller="Accounts" asp-action="Acceso" class="btn public-btn public-btn-primary w-100">
                        Volver a iniciar sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
