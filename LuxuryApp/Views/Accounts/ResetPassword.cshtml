@model LuxuryApp.Models.Identity.ResetPasswordViewModel

@{
    ViewData["Title"] = "Nueva contraseña";
    ViewData["PublicBodyClass"] = "public-auth-page";
    Layout = "_PublicLayout";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5" data-aos="fade-up">
                <div class="auth-form-card">
                    <span class="section-kicker">Seguridad de cuenta</span>
                    <h2>Nueva contraseña</h2>
                    <p class="text-muted mb-4">
                        Elige una contraseña segura para tu cuenta de LuxuryCloud.
                    </p>

                    <form asp-controller="Accounts" asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger auth-validation mb-3"></div>

                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control public-form-control" placeholder="Nueva contraseña" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control public-form-control" placeholder="Repite la contraseña" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn public-btn public-btn-primary w-100">
                            Guardar nueva contraseña
                        </button>

                        <div class="auth-links-row">
                            <a asp-controller="Accounts" asp-action="Acceso">Volver a iniciar sesión</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
