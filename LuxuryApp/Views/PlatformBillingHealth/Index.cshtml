@model LuxuryApp.Services.Billing.BillingHealthSnapshot

@{
    ViewData["Title"] = "Billing Health";

    string FormatUtc(DateTime? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm:ss") + " UTC" : "—";

    string AgeBadge(DateTime? value, int warnHours, int dangerHours)
    {
        if (!value.HasValue)
        {
            return "text-bg-secondary";
        }

        var age = DateTime.UtcNow - value.Value;
        if (age.TotalHours >= dangerHours)
        {
            return "text-bg-danger";
        }

        return age.TotalHours >= warnHours ? "text-bg-warning" : "text-bg-success";
    }

    string CountBadge(int count) => count > 0 ? "text-bg-warning" : "text-bg-success";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Diagnóstico del módulo Billing</h1>
            <p class="text-muted mb-0">
                Fotografía operativa cross-tenant. Generada @FormatUtc(Model.GeneratedAtUtc).
                <a asp-action="Snapshot">Ver JSON</a>
            </p>
        </div>
        <span class="badge text-bg-dark">Solo plataforma</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Suscripciones (estado efectivo)</h2>
                    <div class="row row-cols-2 row-cols-md-4 g-3 text-center">
                        <div><div class="fs-4 fw-bold text-success">@Model.ActiveSubscriptions</div><div class="small text-muted">Activas</div></div>
                        <div><div class="fs-4 fw-bold">@Model.TrialSubscriptions</div><div class="small text-muted">Trial</div></div>
                        <div><div class="fs-4 fw-bold text-warning">@Model.MorosaSubscriptions</div><div class="small text-muted">Morosas</div></div>
                        <div><div class="fs-4 fw-bold text-danger">@Model.SuspendedSubscriptions</div><div class="small text-muted">Suspendidas</div></div>
                        <div><div class="fs-4 fw-bold">@Model.PendingSubscriptions</div><div class="small text-muted">Pendientes</div></div>
                        <div><div class="fs-4 fw-bold">@Model.CancelledSubscriptions</div><div class="small text-muted">Canceladas</div></div>
                        <div><div class="fs-4 fw-bold">@Model.FailedSubscriptions</div><div class="small text-muted">Fallidas</div></div>
                        <div><div class="fs-4 fw-bold">@Model.ActiveWhatsAppAddons</div><div class="small text-muted">Add-ons WA</div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Pagos y renovaciones</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Pagos pendientes
                            <span class="badge text-bg-secondary">@Model.PendingPayments</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            En revisión manual (posible dinero cobrado sin activar)
                            <span class="badge @CountBadge(Model.ManualReviewPayments)">@Model.ManualReviewPayments</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Confirmados últimas 24 h
                            <span class="badge text-bg-success">@Model.ConfirmedPaymentsLast24h</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Fallidos/cancelados últimas 24 h
                            <span class="badge @CountBadge(Model.FailedPaymentsLast24h)">@Model.FailedPaymentsLast24h</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Renovaciones con próximo cobro vencido
                            <span class="badge @CountBadge(Model.OverdueRenewals)">@Model.OverdueRenewals</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Webhooks TiloPay</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Último webhook recibido
                            <span class="badge @AgeBadge(Model.LastWebhookReceivedUtc, 48, 96)">@FormatUtc(Model.LastWebhookReceivedUtc)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Último webhook procesado
                            <span class="badge text-bg-secondary">@FormatUtc(Model.LastWebhookProcessedUtc)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Eventos sin procesar (Recibido/Error)
                            <span class="badge @CountBadge(Model.UnprocessedEvents)">@Model.UnprocessedEvents</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Errores de procesamiento últimas 24 h
                            <span class="badge @CountBadge(Model.ErrorEventsLast24h)">@Model.ErrorEventsLast24h</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Revisión manual últimos 7 días
                            <span class="badge @CountBadge(Model.ManualReviewEventsLast7d)">@Model.ManualReviewEventsLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Sin correlación últimos 7 días
                            <span class="badge @CountBadge(Model.UnmatchedEventsLast7d)">@Model.UnmatchedEventsLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Procesamiento promedio (24 h)
                            <span class="badge text-bg-secondary">
                                @(Model.AvgWebhookProcessingMsLast24h.HasValue
                                    ? $"{Model.AvgWebhookProcessingMsLast24h.Value:0} ms"
                                    : "—")
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Suscriptor recurrente (TiloPay)</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Suscripciones activas sin id_suscriptor
                            <span class="badge @CountBadge(Model.ActiveSubscriptionsWithoutSubscriberId)">@Model.ActiveSubscriptionsWithoutSubscriberId</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Pagos confirmados sin id_suscriptor
                            <span class="badge @CountBadge(Model.ConfirmedPaymentsWithoutSubscriberId)">@Model.ConfirmedPaymentsWithoutSubscriberId</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Resoluciones pendientes (7 días)
                            <span class="badge @CountBadge(Model.SubscriberResolutionsPendingLast7d)">@Model.SubscriberResolutionsPendingLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Resoluciones ambiguas (7 días)
                            <span class="badge @CountBadge(Model.SubscriberResolutionsAmbiguousLast7d)">@Model.SubscriberResolutionsAmbiguousLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Resueltos correctamente (7 días)
                            <span class="badge text-bg-success">@Model.SubscriberResolvedLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Checkouts bloqueados por duplicado (7 días)
                            <span class="badge text-bg-secondary">@Model.CheckoutsBlockedByDuplicateLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Cancelaciones de proveedor fallidas (7 días)
                            <span class="badge @CountBadge(Model.ProviderCancellationsFailedLast7d)">@Model.ProviderCancellationsFailedLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Última resolución exitosa
                            <span class="badge text-bg-secondary">@FormatUtc(Model.LastSuccessfulSubscriberResolutionUtc)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>
                                Checkouts de cambio sin pagar
                                <span class="d-block small text-muted">
                                    El cliente abrió el link y no pagó. Sin riesgo: expiran solos.
                                    @if (Model.OldestPendingCheckoutAgeHours is { } ageHours)
                                    {
                                        <text>Más antiguo: @ageHours h.</text>
                                    }
                                </span>
                            </span>
                            <span class="badge text-bg-secondary">@Model.PlanChangePendingCheckoutCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>
                                Cambios con riesgo de dinero
                                <span class="d-block small text-muted">Pago cobrado sin aplicar, o plan viejo sin cancelar.</span>
                            </span>
                            <span class="badge @(Model.PlanChangeMoneyRiskCount > 0 ? "text-bg-danger" : "text-bg-success")">@Model.PlanChangeMoneyRiskCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Cambios aplicados sin cancelar el plan viejo (riesgo doble cobro)
                            <span class="badge @CountBadge(Model.PlanChangeManualReviewCount)">@Model.PlanChangeManualReviewCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Último cambio de plan aplicado
                            <span class="badge text-bg-secondary">@FormatUtc(Model.LastSuccessfulPlanChangeUtc)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 @(Model.OldCancellationPendingCount > 0 ? "border-start border-4 border-danger" : "")">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Cancelación del suscriptor viejo (riesgo de doble cobro)</h2>

                    <div class="row row-cols-2 row-cols-md-5 g-3 text-center mb-3">
                        <div>
                            <div class="fs-4 fw-bold @(Model.OldCancellationPendingCount > 0 ? "text-danger" : "text-success")">@Model.OldCancellationPendingCount</div>
                            <div class="small text-muted">Pendientes</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.OldCancellationVerifiedStillActiveCount > 0 ? "text-danger" : "text-success")">@Model.OldCancellationVerifiedStillActiveCount</div>
                            <div class="small text-muted">Viejo aún activo (verificado)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.OldCancellationBackoffBlockedCount</div>
                            <div class="small text-muted">Esperando backoff</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.OldCancellationSkippedAutoCancelDisabledCount > 0 ? "text-warning" : "")">@Model.OldCancellationSkippedAutoCancelDisabledCount</div>
                            <div class="small text-muted">Saltados por AutoCancel off (24 h)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.OldCancellationSkippedNotEligibleCount > 0 ? "text-warning" : "")">@Model.OldCancellationSkippedNotEligibleCount</div>
                            <div class="small text-muted">Saltados por datos faltantes (24 h)</div>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Próximo reintento automático
                            <span class="badge @(Model.OldCancellationPendingCount == 0 ? "text-bg-success" : Model.OldCancellationNextRetryUtc is null ? "text-bg-warning" : "text-bg-secondary")">
                                @(Model.OldCancellationPendingCount == 0
                                    ? "sin pendientes"
                                    : Model.OldCancellationNextRetryUtc is null
                                        ? "elegible ya"
                                        : FormatUtc(Model.OldCancellationNextRetryUtc))
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Intentos reales acumulados (peor caso)
                            <span class="badge @CountBadge(Model.OldCancellationMaxAttemptCount)">@Model.OldCancellationMaxAttemptCount</span>
                        </li>
                    </ul>

                    @if (Model.OldCancellationPendingItems.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr class="small text-muted">
                                        <th>Tenant</th>
                                        <th>Plan nuevo</th>
                                        <th>Viejo → Nuevo</th>
                                        <th class="text-center">Intentos</th>
                                        <th>Próximo intento</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OldCancellationPendingItems)
                                    {
                                        <tr>
                                            <td class="small">
                                                @(item.TenantName ?? item.TenantId.ToString())
                                                @if (item.VerifiedStillActive)
                                                {
                                                    <span class="badge text-bg-danger ms-1">viejo activo</span>
                                                }
                                            </td>
                                            <td class="small">@item.ToPlanCode</td>
                                            <td class="small font-monospace">
                                                @item.OldSubscriberSuffix → @item.NewSubscriberSuffix
                                                <span class="text-muted">(plan @item.OldRecurringPlanId)</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @CountBadge(item.AttemptCount)">@item.AttemptCount</span>
                                            </td>
                                            <td class="small">
                                                @(item.NextRetryUtc is null ? "elegible ya" : FormatUtc(item.NextRetryUtc))
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="RetryOldProviderCancellation" asp-route-intentId="@item.IntentId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Reintentar ahora
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-2 small text-muted">
                            El reintento forzado usa la misma lógica del worker: es idempotente, verifica contra
                            <code>getSuscriptorRepeat</code> y nunca cancela un suscriptor que esté cobrando.
                            Solo ignora la espera del backoff.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            Ningún cambio de plan con suscriptor viejo sin cancelar. Sin riesgo de doble cobro.
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 @(Model.ActiveSubscriptionsProviderExpiryEarlierCount > 0 ? "border-start border-4 border-warning" : "")">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Fecha del proveedor vs fecha local (riesgo de morosidad incorrecta)</h2>

                    <div class="row row-cols-2 row-cols-md-4 g-3 text-center mb-3">
                        <div>
                            <div class="fs-4 fw-bold @(Model.ActiveSubscriptionsProviderExpiryAheadCount > 0 ? "text-info" : "text-success")">@Model.ActiveSubscriptionsProviderExpiryAheadCount</div>
                            <div class="small text-muted">TiloPay cobra más tarde (vigencia extendida)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.ActiveSubscriptionsProviderExpiryEarlierCount > 0 ? "text-warning" : "text-success")">@Model.ActiveSubscriptionsProviderExpiryEarlierCount</div>
                            <div class="small text-muted">TiloPay cobra más temprano (revisar)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.ProviderExpiryReconciledLast7d</div>
                            <div class="small text-muted">Extensiones aplicadas (7 días)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.ProviderExpiryMismatchCount</div>
                            <div class="small text-muted">Total con diferencia</div>
                        </div>
                    </div>

                    @if (Model.ProviderExpiryMismatches.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr class="small text-muted">
                                        <th>Tenant</th>
                                        <th>Plan</th>
                                        <th>Fecha local</th>
                                        <th>Fecha TiloPay</th>
                                        <th>Dirección</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ProviderExpiryMismatches)
                                    {
                                        <tr>
                                            <td class="small">@(item.TenantName ?? item.TenantId.ToString())</td>
                                            <td class="small">@item.PlanCode</td>
                                            <td class="small">@(item.LocalEndDisplay ?? "—")</td>
                                            <td class="small">@(item.ProviderExpiryDisplay ?? "—")</td>
                                            <td>
                                                @if (item.ProviderIsAhead)
                                                {
                                                    <span class="badge text-bg-info">proveedor adelante</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning">proveedor atrás</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-2 small text-muted">
                            "Proveedor adelante" es benigno: LuxuryCloud extiende la vigencia y no marca moroso antes de tiempo.
                            "Proveedor atrás" no acorta acceso automáticamente; requiere revisión manual.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Las fechas locales coinciden con TiloPay. Sin riesgo de morosidad incorrecta.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 @((Model.ProviderCancellationsPendingVerification > 0 || Model.ProviderStatusMismatchCount > 0) ? "border-start border-4 border-danger" : "")">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Ciclo de vida (cancelación / pausa / reactivación)</h2>

                    <div class="row row-cols-2 row-cols-md-4 g-3 text-center mb-3">
                        <div>
                            <div class="fs-4 fw-bold">@Model.SubscriptionsCancelAtPeriodEnd</div>
                            <div class="small text-muted">Renovación cancelada (con acceso)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.ProviderCancellationsPendingVerification > 0 ? "text-danger" : "text-success")">@Model.ProviderCancellationsPendingVerification</div>
                            <div class="small text-muted">Cancelaciones sin verificar</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.ProviderPausedSubscriptions</div>
                            <div class="small text-muted">Pausadas en el proveedor</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.ProviderStatusMismatchCount > 0 ? "text-danger" : "text-success")">@Model.ProviderStatusMismatchCount</div>
                            <div class="small text-muted">Desajustes local↔proveedor (7 días)</div>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Cancelaciones en revisión manual (7 días)
                            <span class="badge @CountBadge(Model.ProviderCancellationFailedLast7d)">@Model.ProviderCancellationFailedLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Pausas fallidas (7 días)
                            <span class="badge @CountBadge(Model.PauseFailedLast7d)">@Model.PauseFailedLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Reactivaciones fallidas / bloqueadas (7 días)
                            <span class="badge @CountBadge(Model.ReactivationFailedLast7d)">@Model.ReactivationFailedLast7d</span>
                        </li>
                    </ul>

                    <div class="mt-3 small text-muted">
                        Gestioná una suscripción (pausar / reactivar / cancelar) en
                        <a asp-controller="PlatformProviderSubscription" asp-action="Manage">gestión de suscripción</a> (por Tenant Id).
                        "Cancelaciones sin verificar" y "desajustes" son riesgo de que el proveedor siga cobrando: revisar.
                        Los contadores "(7 días)" son <strong>históricos</strong> (auditoría de la última semana), no incidentes abiertos ahora;
                        "Pausadas en el proveedor" y "Renovación cancelada" sí reflejan el estado actual.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 @((Model.GraceExpiredNotSuspended > 0 || Model.SuspendedForNonPayment > 0 || Model.PaymentRecoveryNotificationsFailedLast7d > 0) ? "border-start border-4 border-warning" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <h2 class="h6 text-uppercase text-muted mb-0">Recuperación de pago (pago fallido / gracia / suspensión)</h2>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="PlatformPaymentRecovery" asp-action="Index">
                            <i class="bi bi-life-preserver"></i> Ver incidentes
                        </a>
                    </div>

                    <div class="row row-cols-2 row-cols-md-4 g-3 text-center mb-3">
                        <div>
                            <div class="fs-4 fw-bold @(Model.OpenPaymentRecoveryIncidents > 0 ? "text-warning" : "text-success")">@Model.OpenPaymentRecoveryIncidents</div>
                            <div class="small text-muted">Incidentes abiertos</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.ActiveGracePeriods</div>
                            <div class="small text-muted">Gracias vigentes (con acceso)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.GraceExpiredNotSuspended > 0 ? "text-warning" : "text-success")">@Model.GraceExpiredNotSuspended</div>
                            <div class="small text-muted">Gracia vencida SIN suspensión (config)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.SuspendedForNonPayment > 0 ? "text-danger" : "text-success")">@Model.SuspendedForNonPayment</div>
                            <div class="small text-muted">Suspendidas por impago</div>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Incidentes en revisión manual
                            <span class="badge @CountBadge(Model.PaymentRecoveryManualReviewCount)">@Model.PaymentRecoveryManualReviewCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Notificaciones fallidas (7 días)
                            <span class="badge @CountBadge(Model.PaymentRecoveryNotificationsFailedLast7d)">@Model.PaymentRecoveryNotificationsFailedLast7d</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Fallos al generar enlace de actualización (7 días)
                            <span class="badge @CountBadge(Model.PaymentMethodUpdateUrlFailuresLast7d)">@Model.PaymentMethodUpdateUrlFailuresLast7d</span>
                        </li>
                    </ul>

                    <div class="mt-3 small text-muted">
                        <strong>"Gracia vencida sin suspensión"</strong> = la gracia terminó pero el acceso se conserva a propósito
                        (AutoSuspendAfterGrace=false): requieren atención manual, no están cortadas.
                        <strong>"Suspendidas por impago"</strong> = el acceso sí se cortó (solo con AutoSuspendAfterGrace=true).
                        Los contadores "(7 días)" son históricos. Gestioná caso por caso en
                        <a asp-controller="PlatformPaymentRecovery" asp-action="Index">Recuperación de pago</a>.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 @((Model.WhatsAppAddonMoneyRiskCount > 0 || Model.WhatsAppAddonsWithoutActiveBase > 0) ? "border-start border-4 border-danger" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <h2 class="h6 text-uppercase text-muted mb-0">Add-on WhatsApp (ciclo independiente del plan base)</h2>
                        <span class="badge @(Model.WhatsAppAddonMoneyRiskCount > 0 ? "text-bg-danger" : "text-bg-success")">
                            Dinero en riesgo add-on: @Model.WhatsAppAddonMoneyRiskCount
                        </span>
                    </div>

                    <div class="row row-cols-2 row-cols-md-4 g-3 text-center mb-3">
                        <div>
                            <div class="fs-4 fw-bold">@Model.ActiveWhatsAppAddons</div>
                            <div class="small text-muted">Add-ons activos</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.WhatsAppAddonsPendingProviderCancellation > 0 ? "text-danger" : "text-success")">@Model.WhatsAppAddonsPendingProviderCancellation</div>
                            <div class="small text-muted">Suscriptores pendientes de baja (doble cobro)</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.WhatsAppAddonsWithoutActiveBase > 0 ? "text-warning" : "text-success")">@Model.WhatsAppAddonsWithoutActiveBase</div>
                            <div class="small text-muted">Activos sin plan base</div>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold @(Model.WhatsAppAddonsDoubleActiveTenants > 0 ? "text-danger" : "text-success")">@Model.WhatsAppAddonsDoubleActiveTenants</div>
                            <div class="small text-muted">Tenants con doble add-on (debe ser 0)</div>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Incidentes de pago del add-on abiertos
                            <span class="badge @CountBadge(Model.WhatsAppAddonOpenPaymentIncidents)">@Model.WhatsAppAddonOpenPaymentIncidents</span>
                        </li>
                    </ul>

                    @* Estado REAL en TiloPay. Lo local no puede verlo: sin esta sección el tablero
                       podía decir riesgo 0 con WA400 y WA800 cobrables a la vez en el proveedor. *@
                    <div class="d-flex justify-content-between align-items-center gap-2 mt-3 mb-2">
                        <h3 class="h6 text-uppercase text-muted mb-0">Estado real en TiloPay (última auditoría del proveedor)</h3>
                        <form asp-action="AuditAddonProvider" method="post" class="d-flex gap-2 align-items-center">
                            <input type="text" name="tenantId" class="form-control form-control-sm" style="max-width: 20rem;"
                                   placeholder="TenantId a auditar" required />
                            <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap"
                                    title="Solo lectura contra getSuscriptorRepeat: no cancela nada.">
                                Auditar proveedor
                            </button>
                        </form>
                    </div>
                    @if (Model.LastProviderAddonAuditUtc is null)
                    {
                        <div class="alert alert-warning py-2 mb-0 small">
                            Nunca se auditó el proveedor: el verde de arriba <strong>no está verificado contra TiloPay</strong>.
                            Corré la reconciliación para poblar el snapshot.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                Tenants con DOBLE add-on cobrable en TiloPay (debe ser 0)
                                <span class="badge @(Model.ProviderDoubleActiveWhatsAppAddonTenants > 0 ? "text-bg-danger" : "text-bg-success")">@Model.ProviderDoubleActiveWhatsAppAddonTenants</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                Máx. suscriptores de add-on cobrables en un tenant (debe ser 1)
                                <span class="badge @(Model.ProviderMaxActiveAddonSubscribersByTenant > 1 ? "text-bg-danger" : "text-bg-success")">@Model.ProviderMaxActiveAddonSubscribersByTenant</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                Auditorías no concluyentes (no se declara sano)
                                <span class="badge @CountBadge(Model.ProviderWhatsAppAddonAuditInconclusiveTenants)">@Model.ProviderWhatsAppAddonAuditInconclusiveTenants</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                Última auditoría del proveedor (UTC)
                                <span class="text-muted small">@Model.LastProviderAddonAuditUtc.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            </li>
                        </ul>
                    }

                    @if (Model.WhatsAppAddonCheckoutConfig.Any())
                    {
                        <h3 class="h6 text-uppercase text-muted mt-3 mb-2">Config de checkout (efectiva) por add-on</h3>
                        <ul class="list-group list-group-flush">
                            @foreach (var cfg in Model.WhatsAppAddonCheckoutConfig)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>@cfg.Code <span class="text-muted small">(plan @cfg.TilopayPlanId)</span></span>
                                    @if (cfg.HasCheckoutUrl)
                                    {
                                        <span class="badge text-bg-success" title="@cfg.CheckoutUrlDescriptor">HasCheckoutUrl = true</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">HasCheckoutUrl = false</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    <div class="mt-3 small text-muted">
                        Sección SEPARADA a propósito: el dinero-en-riesgo del add-on NO se mezcla con el del plan base.
                        <strong>"Suscriptores pendientes de baja"</strong> = un cambio de paquete / cascada dejó un suscriptor
                        que TiloPay podría seguir cobrando; si crece, el API admin de cancelación puede estar apagado.
                        <strong>"HasCheckoutUrl = false"</strong> = ese add-on no se puede vender por checkout recurrente hasta
                        cargar el hosted link real (la URL nunca se muestra por seguridad).
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Reconciliación automática</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Última reconciliación
                            <span class="badge @AgeBadge(Model.LastReconciliationUtc, 26, 50)">@FormatUtc(Model.LastReconciliationUtc)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Alertas abiertas últimas 24 h
                            <span class="badge @CountBadge(Model.OpenAlertsLast24h)">@Model.OpenAlertsLast24h</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Reparaciones automáticas últimos 7 días
                            <span class="badge text-bg-secondary">@Model.AutoRepairsLast7d</span>
                        </li>
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(Model.LastReconciliationSummaryJson))
                    {
                        <div class="mt-3">
                            <div class="small text-muted mb-1">Resumen del último pase</div>
                            <pre class="small bg-body-tertiary rounded p-2 mb-0" style="white-space: pre-wrap;">@Model.LastReconciliationSummaryJson</pre>
                        </div>
                    }

                    <div class="mt-3 small text-muted">
                        Los hallazgos que requieren decisión humana aparecen en la bitácora de plataforma
                        (acción <code>BillingReconciliationAlert</code>) y los pagos por conciliar en
                        <a href="/Platform/RecurringCheckouts">Conciliación recurrente</a>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
