@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = ViewData["FullTitle"] as string;

    if (string.IsNullOrWhiteSpace(fullTitle))
    {
        if (string.IsNullOrWhiteSpace(pageTitle))
        {
            fullTitle = "LuxuryCloud";
        }
        else if (pageTitle.Contains('|'))
        {
            fullTitle = pageTitle;
        }
        else if (string.Equals(pageTitle, "LuxuryCloud", StringComparison.OrdinalIgnoreCase))
        {
            fullTitle = pageTitle;
        }
        else
        {
            fullTitle = $"{pageTitle} | LuxuryCloud";
        }
    }

    var metaDescription = ViewData["MetaDescription"] as string;
    var canonicalUrl = ViewData["CanonicalUrl"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LuxuryApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-shell @(ViewData["PublicBodyClass"] as string)">
    <partial name="_PublicNavbar" />

    <main class="public-main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container">
            <div class="public-footer-grid">

                <!-- Columna 1: Marca -->
                <div class="public-footer-col public-footer-col-brand">
                    <a class="public-footer-brand" asp-controller="Home" asp-action="Index">
                        <span class="public-brand-mark">L</span>
                        LuxuryCloud
                    </a>
                    <p class="public-footer-copy">
                        Plataforma SaaS para barberías, salones y negocios de servicios que necesitan operar con más control, trazabilidad y una experiencia comercial más clara.
                    </p>
                    <div class="public-footer-socials">
                        @* TODO: reemplazar # con las URLs reales de redes sociales *@
                        <a href="#" class="public-footer-social-link" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="public-footer-social-link" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="public-footer-social-link" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        <a href="#" class="public-footer-social-link" aria-label="Correo"><i class="bi bi-envelope"></i></a>
                    </div>
                </div>

                <!-- Columna 2: Plataforma -->
                <div class="public-footer-col">
                    <p class="public-footer-col-title">Plataforma</p>
                    <ul class="public-footer-col-list">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="modulos">Módulos</a></li>
                        <li><a asp-controller="Billing" asp-action="Planes">Precios</a></li>
                        <li><a asp-controller="Accounts" asp-action="Registro">Registrarse</a></li>
                        <li><a asp-controller="Accounts" asp-action="Acceso">Iniciar sesión</a></li>
                    </ul>
                </div>

                <!-- Columna 3: Funcionalidades -->
                <div class="public-footer-col">
                    <p class="public-footer-col-title">Funcionalidades</p>
                    <ul class="public-footer-col-list">
                        <li><span>Agenda inteligente</span></li>
                        <li><span>Gestión de clientes</span></li>
                        <li><span>Control de ingresos</span></li>
                        <li><span>Control de egresos</span></li>
                        <li><span>Productos e inventario</span></li>
                        <li><span>Funcionarios y comisiones</span></li>
                        <li><span>Confirmaciones por WhatsApp</span></li>
                    </ul>
                </div>

                <!-- Columna 4: Legal y soporte -->
                <div class="public-footer-col">
                    <p class="public-footer-col-title">Legal y soporte</p>
                    <ul class="public-footer-col-list">
                        <li><a asp-controller="Contract" asp-action="Index">Contrato</a></li>
                        <li><a href="/privacidad">Privacidad</a></li>
                        <li><a asp-controller="Home" asp-action="DataDeletion">Eliminación de datos</a></li>
                        @* TODO: reemplazar # con URLs reales de soporte y contacto *@
                        <li><a href="#">Soporte</a></li>
                        <li><a href="#">Contacto</a></li>
                    </ul>
                </div>

            </div>

            <div class="public-footer-bottom">
                <span class="public-footer-copyright">&copy; @DateTime.UtcNow.Year LuxuryCloud. Todos los derechos reservados.</span>
                <p class="public-footer-tagline">Hecho para negocios de belleza y servicios que quieren operar con orden.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="~/js/public-site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
