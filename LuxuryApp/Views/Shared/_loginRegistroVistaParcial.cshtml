@using Microsoft.AspNetCore.Identity
@using LuxuryApp.Models.Identity

@inject SignInManager<AppUsuario> SignInManager
@inject UserManager<AppUsuario> UserManager

<ul class="navbar-nav ml-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-white" href="">Hola, @UserManager.GetUserName(User)</a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" method="post" class="form-inline" asp-controller="Accounts" asp-action="SalirAplicacion">
                <button type="submit" class="btn nav-link">Salir</button>
            </form>
         </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="" asp-controller="Accounts" asp-action="Registro">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="" asp-controller="Accounts" asp-action="Acceso">Acceder</a>
        </li>
    }
</ul>
