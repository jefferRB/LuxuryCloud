@model LuxuryApp.Models.Platform.PlatformUsersPageViewModel

@{
    ViewData["Title"] = "Usuarios - Plataforma";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform.css" asp-append-version="true" />
}

<div class="platform-shell">
    <div class="platform-hero">
        <div>
            <span class="platform-eyebrow">
                <i class="bi bi-people"></i>
                Administración de usuarios
            </span>
            <h1 class="platform-title">Usuarios de la plataforma</h1>
            <p class="platform-subtitle">
                Supervisa todas las cuentas por negocio. Las acciones sensibles (desactivar/reactivar)
                exigen confirmación escrita y tu contraseña de SuperAdmin, y quedan auditadas.
            </p>
        </div>
        <div class="platform-toolbar">
            <a class="btn btn-outline-dark platform-btn" asp-controller="Platform" asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Volver a Plataforma
            </a>
            <a class="btn btn-outline-dark platform-btn" asp-controller="PlatformUsers" asp-action="Auditoria">
                <i class="bi bi-clipboard-check"></i>
                Auditoría
            </a>
        </div>
    </div>

    @if (TempData["PlatformError"] is string platformError)
    {
        <div class="platform-alert-stack">
            <div class="alert alert-danger platform-alert mb-0">@platformError</div>
        </div>
    }
    @if (TempData["PlatformSuccess"] is string platformSuccess)
    {
        <div class="platform-alert-stack">
            <div class="alert alert-success platform-alert mb-0">@platformSuccess</div>
        </div>
    }

    <section class="platform-section-card">
        <div class="platform-section-header">
            <div>
                <p class="platform-section-kicker">Cuentas</p>
                <h2 class="platform-section-title">Listado de usuarios</h2>
                <p class="platform-section-copy">
                    @Model.TotalCount usuario(s) en total ·
                    Página @Model.CurrentPage de @Model.TotalPages ·
                    @Model.TotalActive activos / @Model.TotalInactive inactivos en esta página.
                </p>
            </div>
        </div>

        <form method="get" asp-controller="PlatformUsers" asp-action="Usuarios" class="row g-2 platform-inline-form mb-3">
            <div class="col-12 col-md-6">
                <input class="form-control form-control-sm" type="search" name="q" value="@Model.SearchTerm"
                       placeholder="Buscar por correo, nombre o negocio" aria-label="Buscar usuario" />
            </div>
            <div class="col-8 col-md-4">
                <select class="form-select form-select-sm" name="estado" aria-label="Estado">
                    <option value="" selected="@string.IsNullOrEmpty(Model.StatusFilter)">Todos los estados</option>
                    <option value="activos" selected="@(Model.StatusFilter == "activos")">Solo activos</option>
                    <option value="inactivos" selected="@(Model.StatusFilter == "inactivos")">Solo inactivos</option>
                </select>
            </div>
            <div class="col-4 col-md-2 d-grid">
                <button type="submit" class="btn btn-dark btn-sm platform-btn">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>
            </div>
        </form>

        @if (Model.Users.Count == 0)
        {
            <div class="platform-empty-state">
                <i class="bi bi-inbox"></i>
                <p class="mb-0">No se encontraron usuarios con esos criterios.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table platform-table align-middle">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Negocio</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="platform-table-title">@(string.IsNullOrWhiteSpace(user.Name) ? user.Email : user.Name)</div>
                                    <div class="platform-table-meta">@user.Email</div>
                                </td>
                                <td>
                                    <div class="platform-table-title">@user.TenantName</div>
                                    <div class="platform-table-meta">
                                        @(user.TenantActive ? "Negocio activo" : "Negocio suspendido")
                                    </div>
                                </td>
                                <td>
                                    <div class="platform-badge-row">
                                        @if (user.IsPlatformSuperAdmin)
                                        {
                                            <span class="platform-badge platform-badge-dark">
                                                <i class="bi bi-shield-lock"></i> SuperAdmin
                                            </span>
                                        }
                                        @if (user.IsFuncionario)
                                        {
                                            <span class="platform-badge platform-badge-blue">
                                                <i class="bi bi-person-badge"></i> Funcionario
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(user.Roles))
                                        {
                                            <span class="platform-table-meta">@user.Roles</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="platform-badge @(user.State ? "platform-badge-success" : "platform-badge-danger")">
                                        <i class="bi @(user.State ? "bi-check-circle" : "bi-slash-circle")"></i>
                                        @(user.State ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="platform-table-actions justify-content-end">
                                        @if (user.State)
                                        {
                                            <a class="btn btn-outline-danger btn-sm platform-btn"
                                               asp-controller="PlatformUsers" asp-action="ConfirmarDesactivacion"
                                               asp-route-userId="@user.UserId">
                                                <i class="bi bi-person-x"></i>
                                                Desactivar
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-outline-success btn-sm platform-btn"
                                               asp-controller="PlatformUsers" asp-action="ConfirmarReactivacion"
                                               asp-route-userId="@user.UserId">
                                                <i class="bi bi-person-check"></i>
                                                Reactivar
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginación de usuarios" class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="PlatformUsers" asp-action="Usuarios"
                               asp-route-q="@Model.SearchTerm"
                               asp-route-estado="@Model.StatusFilter"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="PlatformUsers" asp-action="Usuarios"
                                   asp-route-q="@Model.SearchTerm"
                                   asp-route-estado="@Model.StatusFilter"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="PlatformUsers" asp-action="Usuarios"
                               asp-route-q="@Model.SearchTerm"
                               asp-route-estado="@Model.StatusFilter"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
