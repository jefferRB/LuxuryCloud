@using LuxuryApp.Models.Platform
@model LuxuryApp.Models.Platform.PlatformAuditPageViewModel

@{
    ViewData["Title"] = "Auditoría - Plataforma";

    (string label, string badge) DescribeAction(string action) => action switch
    {
        PlatformAuditActions.UserDeactivated => ("Usuario desactivado", "platform-badge-danger"),
        PlatformAuditActions.UserReactivated => ("Usuario reactivado", "platform-badge-success"),
        PlatformAuditActions.DangerousActionPasswordFailed => ("Contraseña incorrecta", "platform-badge-warning"),
        PlatformAuditActions.DangerousActionBlocked => ("Acción bloqueada", "platform-badge-warning"),
        PlatformAuditActions.TenantCommercialAccessUpdated => ("Acceso comercial", "platform-badge-blue"),
        PlatformAuditActions.WhatsAppSettingsUpdated => ("WhatsApp", "platform-badge-blue"),
        PlatformAuditActions.MetaDiagnosticExecuted => ("Diagnóstico Meta", "platform-badge-dark"),
        _ => (action, "platform-badge-dark")
    };

    var knownActions = new[]
    {
        PlatformAuditActions.UserDeactivated,
        PlatformAuditActions.UserReactivated,
        PlatformAuditActions.DangerousActionPasswordFailed,
        PlatformAuditActions.DangerousActionBlocked,
        PlatformAuditActions.TenantCommercialAccessUpdated,
        PlatformAuditActions.WhatsAppSettingsUpdated,
        PlatformAuditActions.MetaDiagnosticExecuted
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform.css" asp-append-version="true" />
}

<div class="platform-shell">
    <div class="platform-hero">
        <div>
            <span class="platform-eyebrow">
                <i class="bi bi-clipboard-check"></i>
                Trazabilidad
            </span>
            <h1 class="platform-title">Auditoría de plataforma</h1>
            <p class="platform-subtitle">
                Registro append-only de las acciones internas del SuperAdmin. No puede editarse ni borrarse.
            </p>
        </div>
        <div class="platform-toolbar">
            <a class="btn btn-outline-dark platform-btn" asp-controller="PlatformUsers" asp-action="Usuarios">
                <i class="bi bi-people"></i>
                Usuarios
            </a>
            <a class="btn btn-outline-dark platform-btn" asp-controller="Platform" asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Volver a Plataforma
            </a>
        </div>
    </div>

    <section class="platform-section-card">
        <div class="platform-section-header">
            <div>
                <p class="platform-section-kicker">Filtros</p>
                <h2 class="platform-section-title">Buscar en el registro</h2>
            </div>
        </div>

        <form method="get" asp-controller="PlatformUsers" asp-action="Auditoria" class="row g-2 platform-inline-form mb-3">
            <div class="col-12 col-md-4">
                <select class="form-select form-select-sm" name="filtroAccion" aria-label="Acción">
                    <option value="" selected="@string.IsNullOrEmpty(Model.FiltroAccion)">Todas las acciones</option>
                    @foreach (var a in knownActions)
                    {
                        var info = DescribeAction(a);
                        <option value="@a" selected="@(Model.FiltroAccion == a)">@info.label</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <input class="form-control form-control-sm" type="search" name="filtroTenant"
                       value="@Model.FiltroTenant" placeholder="Negocio" aria-label="Filtrar por negocio" />
            </div>
            <div class="col-12 col-md-3">
                <input class="form-control form-control-sm" type="search" name="filtroActor"
                       value="@Model.FiltroActor" placeholder="Actor (correo)" aria-label="Filtrar por actor" />
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button type="submit" class="btn btn-dark btn-sm platform-btn">
                    <i class="bi bi-search"></i>
                    Filtrar
                </button>
            </div>
        </form>

        <p class="platform-section-copy">
            @Model.TotalCount registro(s) · Página @Model.CurrentPage de @Model.TotalPages
        </p>

        @if (Model.Entries.Count == 0)
        {
            <div class="platform-empty-state">
                <i class="bi bi-inbox"></i>
                <p class="mb-0">No hay registros con esos criterios.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table platform-table align-middle">
                    <thead>
                        <tr>
                            <th>Fecha (UTC)</th>
                            <th>Acción</th>
                            <th>Actor</th>
                            <th>Objetivo</th>
                            <th>Negocio</th>
                            <th>Motivo</th>
                            <th>Origen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            var info = DescribeAction(entry.Action);
                            <tr>
                                <td><div class="platform-table-meta">@entry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div></td>
                                <td>
                                    <span class="platform-badge @info.badge">@info.label</span>
                                </td>
                                <td><div class="platform-table-meta">@entry.ActorEmail</div></td>
                                <td><div class="platform-table-meta">@(entry.TargetUserEmail ?? "—")</div></td>
                                <td><div class="platform-table-meta">@(entry.TenantName ?? "—")</div></td>
                                <td><div class="platform-table-meta">@(entry.Reason ?? "—")</div></td>
                                <td><div class="platform-table-meta">@(entry.IpAddress ?? "—")</div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginación de auditoría" class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="PlatformUsers" asp-action="Auditoria"
                               asp-route-filtroAccion="@Model.FiltroAccion"
                               asp-route-filtroTenant="@Model.FiltroTenant"
                               asp-route-filtroActor="@Model.FiltroActor"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="PlatformUsers" asp-action="Auditoria"
                                   asp-route-filtroAccion="@Model.FiltroAccion"
                                   asp-route-filtroTenant="@Model.FiltroTenant"
                                   asp-route-filtroActor="@Model.FiltroActor"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="PlatformUsers" asp-action="Auditoria"
                               asp-route-filtroAccion="@Model.FiltroAccion"
                               asp-route-filtroTenant="@Model.FiltroTenant"
                               asp-route-filtroActor="@Model.FiltroActor"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
