@model LuxuryApp.Models.Platform.DeactivateUserViewModel

@{
    ViewData["Title"] = "Reactivar usuario - Plataforma";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform.css" asp-append-version="true" />
}

<div class="platform-shell">
    <div class="platform-hero">
        <div>
            <span class="platform-eyebrow">
                <i class="bi bi-person-check"></i>
                Reactivación
            </span>
            <h1 class="platform-title">Reactivar usuario</h1>
            <p class="platform-subtitle">
                El usuario podrá volver a iniciar sesión. Esta acción requiere tu contraseña y queda auditada.
            </p>
        </div>
        <div class="platform-toolbar">
            <a class="btn btn-outline-dark platform-btn" asp-controller="PlatformUsers" asp-action="Usuarios">
                <i class="bi bi-arrow-left"></i>
                Cancelar
            </a>
        </div>
    </div>

    <section class="platform-section-card">
        <div class="platform-section-header">
            <div>
                <p class="platform-section-kicker">Cuenta objetivo</p>
                <h2 class="platform-section-title">@(string.IsNullOrWhiteSpace(Model.UserName) ? Model.UserEmail : Model.UserName)</h2>
                <p class="platform-section-copy">
                    Correo: <strong>@Model.UserEmail</strong> · Negocio: <strong>@Model.TenantName</strong>
                </p>
            </div>
        </div>

        <div asp-validation-summary="All" class="alert alert-danger platform-alert" role="alert"></div>

        <form method="post"
              asp-controller="PlatformUsers" asp-action="Reactivar" asp-route-userId="@Model.UserId">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="TenantId" />

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" asp-for="Reason">Motivo (obligatorio)</label>
                    <textarea class="form-control" asp-for="Reason" rows="2"
                              placeholder="Ej.: el colaborador regresa, se desactivó por error..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="CurrentSuperAdminPassword">Tu contraseña de SuperAdmin</label>
                    <input class="form-control" type="password" asp-for="CurrentSuperAdminPassword" autocomplete="current-password" />
                    <span asp-validation-for="CurrentSuperAdminPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-success platform-btn">
                        <i class="bi bi-person-check"></i>
                        Reactivar usuario
                    </button>
                    <a class="btn btn-outline-dark platform-btn" asp-controller="PlatformUsers" asp-action="Usuarios">
                        Cancelar
                    </a>
                </div>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
