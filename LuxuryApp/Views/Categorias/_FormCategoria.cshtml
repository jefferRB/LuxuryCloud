@model LuxuryApp.Models.Finanzas.Categoria

<div class="svc-form-container">

    <form id="formCategoria">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="svc-alert svc-alert--danger mb-3"
             role="alert"
             style="display:@(ViewData.ModelState.IsValid ? "none" : "flex");"></div>

        <div class="finance-form-grid" style="gap:0.85rem 1.25rem;">

            <div class="finance-form-field">
                <label class="finance-form-label">
                    Nombre <span class="finance-required">*</span>
                </label>
                <div class="finance-input-wrap">
                    <span class="finance-input-icon"><i class="bi bi-folder2"></i></span>
                    <input asp-for="Nombre"
                           class="finance-form-control"
                           placeholder="Nombre de la categoría" />
                </div>
                <span asp-validation-for="Nombre" class="finance-field-error"></span>
            </div>

            <div class="finance-form-field">
                <label class="finance-form-label">
                    Detalle <span class="finance-required">*</span>
                </label>
                <div class="finance-input-wrap">
                    <span class="finance-input-icon"><i class="bi bi-card-text"></i></span>
                    <input asp-for="Detalle"
                           class="finance-form-control"
                           placeholder="Descripción breve de la categoría" />
                </div>
                <span asp-validation-for="Detalle" class="finance-field-error"></span>
            </div>

        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="button"
                    class="finance-btn-save"
                    onclick="guardarCategoria()">
                <i class="bi bi-floppy2-fill"></i>
                @(Model.Id > 0 ? "Guardar Cambios" : "Guardar")
            </button>
            <button type="button"
                    class="finance-btn-back"
                    onclick="document.getElementById('formCategoriaContainer').innerHTML=''">
                <i class="bi bi-x-lg"></i> Cancelar
            </button>
        </div>

    </form>
</div>
