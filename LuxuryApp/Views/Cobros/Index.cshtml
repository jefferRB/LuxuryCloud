<!-- ═══════════════════════════════════════════════════════════
     MODAL: CONFIRMAR ELIMINAR SERVICIO
     ═══════════════════════════════════════════════════════════ -->
<div class="modal fade finance-delete-modal" id="modalEliminarServicio" tabindex="-1"
     aria-labelledby="lblEliminarServicio" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="finance-delete-modal-title" id="lblEliminarServicio">
                    <div class="finance-delete-modal-icon">
                        <i class="bi bi-scissors"></i>
                    </div>
                    Eliminar Servicio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div style="display:flex;align-items:center;gap:0.75rem;padding:0.85rem 1rem;border-radius:12px;background:var(--private-row-bg);border:1px solid var(--private-surface-border);margin-bottom:1rem;">
                    <div style="width:2.5rem;height:2.5rem;border-radius:0.6rem;background:rgba(220,38,38,0.1);display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#dc2626;flex-shrink:0;">
                        <i class="bi bi-scissors"></i>
                    </div>
                    <div>
                        <span style="display:block;font-weight:700;font-size:0.925rem;color:var(--private-surface-text);"
                              id="eliminarServicioNombre"></span>
                        <span style="font-size:0.78rem;color:var(--private-muted-text);">Servicio</span>
                    </div>
                </div>
                <div class="finance-delete-warning-box">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>
                        Esta acción es permanente y no se puede deshacer.
                        Solo es posible si el servicio no tiene cobros ni citas asociadas.
                    </span>
                </div>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="eliminarServicioId" value="" />
                <button type="button" class="finance-btn-back" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button"
                        class="finance-btn-danger-form"
                        onclick="var id=document.getElementById('eliminarServicioId').value; bootstrap.Modal.getInstance(document.getElementById('modalEliminarServicio')).hide(); eliminarServicio(id);">
                    <i class="bi bi-trash3-fill"></i>
                    Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ── filtros ─────────────────────────────────────────── */
        function toggleRangoFechas() {
            var select = document.getElementById("vistaTiempoSelect");
            var container = document.getElementById("rangoFechasContainer");
            container.classList.toggle("d-none", select.value !== "fechas");
        }

        /* ── paginación (conserva filtros; cambiar filtro vuelve a página 1) ── */
        function resetPage() {
            var p = document.getElementById("filtroPage");
            if (p) p.value = 1;
        }
        function gotoPage(n) {
            var p = document.getElementById("filtroPage");
            if (p) p.value = n;
            document.getElementById("formFiltros").submit();
        }
        function setPageSize(v) {
            var ps = document.getElementById("filtroPageSize");
            if (ps) ps.value = v;
            resetPage();
            document.getElementById("formFiltros").submit();
        }

        document.addEventListener("DOMContentLoaded", function () {
            var form = document.getElementById("formFiltros");
            // Solo los campos de FILTRO (no los hidden de paginación) reenvían al cambiar.
            var filtros = form.querySelectorAll("select:not(#pageSizeSelect), input:not([type=hidden])");

            toggleRangoFechas();

            filtros.forEach(function (filtro) {
                filtro.addEventListener("change", function () {
                    resetPage(); // cambiar un filtro siempre vuelve a la página 1
                    if (this.id === "vistaTiempoSelect") {
                        toggleRangoFechas();
                        if (this.value !== "fechas") form.submit();
                        return;
                    }
                    form.submit();
                });
            });
        });

        document.querySelectorAll("#rangoFechasContainer input").forEach(function (input) {
            input.addEventListener("change", function () {
                var inicio = document.querySelector("[name='Filtros.FechaInicio']").value;
                var fin    = document.querySelector("[name='Filtros.FechaFin']").value;
                if (inicio && fin) {
                    resetPage();
                    document.getElementById("formFiltros").submit();
                }
            });
        });

        /* ── eliminar cobro (modal premium) ─────────────────── */
        function abrirEliminarCobro(btn) {
            document.getElementById('deleteCobro_Cliente').textContent    = btn.dataset.cliente    || '—';
            document.getElementById('deleteCobro_Funcionario').textContent = btn.dataset.funcionario || '—';
            document.getElementById('deleteCobro_Servicio').textContent   = btn.dataset.servicio   || '—';
            document.getElementById('deleteCobro_Monto').textContent      = btn.dataset.monto      || '—';
            document.getElementById('deleteCobro_Fecha').textContent      = btn.dataset.fecha      || '—';
            document.getElementById('deleteCobroForm').action             = btn.dataset.action;
            new bootstrap.Modal(document.getElementById('modalEliminarCobro')).show();
        }
    </script>
}
