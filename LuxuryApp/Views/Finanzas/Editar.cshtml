@model LuxuryApp.Models.Funcionarios.Funcionario

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-edit me-2"></i>Editar Funcionario
        </h5>
    </div>

    <div class="card-body">

        <form asp-action="Editar" method="post">

            <input type="hidden" asp-for="IdFuncionario" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Puesto" class="form-label"></label>
                <input asp-for="Puesto" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PorcentajeGanancia" class="form-label"></label>
                <input asp-for="PorcentajeGanancia"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ColorCalendario" class="form-label"></label>
                <input asp-for="ColorCalendario"
                       type="color"
                       class="form-control form-control-color" />
            </div>

            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label"></label>
                <input asp-for="FechaIngreso"
                       type="date"
                       class="form-control" />
            </div>

            <div class="alert alert-light border mb-3">
                El estado del funcionario se administra desde acciones internas del sistema.
            </div>

            <div class="d-flex justify-content-between">

                <a asp-action="Index" class="btn btn-secondary">
                    Volver
                </a>

                <button type="submit" class="btn btn-dark">
                    Guardar Cambios
                </button>

            </div>

        </form>

        <div class="d-flex justify-content-end mt-4">

            <form asp-action="Eliminar"
                  method="post"
                  onsubmit="return confirm('¿Eliminar funcionario?');">

                <input type="hidden" asp-for="IdFuncionario" />

                <button class="btn btn-danger">
                    Eliminar Funcionario
                </button>

            </form>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
