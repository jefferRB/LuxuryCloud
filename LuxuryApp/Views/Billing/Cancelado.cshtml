@{
    Layout = "_CheckoutReturnLayout";
    ViewData["Title"] = "Pago no completado";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-3">Pago no completado</h1>
                    <div class="alert alert-warning" role="alert">
                        @(ViewBag.CancelMessage ?? "No completaste el proceso.")
                    </div>

                    <a class="btn btn-outline-secondary" href="/Billing/Planes">Intentar de nuevo</a>
                </div>
            </div>
        </div>
    </div>
</div>
