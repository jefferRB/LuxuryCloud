@model LuxuryApp.Models.Productos.ProductoViewModel

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">

<div class="kpi-card prod-form-shell">

    <!-- ── CABECERA ── -->
    <div class="prod-form-header">
        <div class="module-heading">
            <span class="module-eyebrow">GESTIÓN DE PRODUCTOS</span>
            <h1 class="module-title"><i class="bi bi-pencil-square module-title-icon" aria-hidden="true"></i>Editar Producto</h1>
        </div>
        <hr class="prod-form-divider" />
    </div>

    <!-- ── CUERPO ── -->
    <div class="prod-form-body">

        <form asp-action="Edit" method="post" asp-route-id="@Model.Producto.IdProducto">

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="prod-validation-summary" role="alert">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <input type="hidden" asp-for="Producto.IdProducto" />

            <partial name="_ProductoForm" model="Model" />

            <!-- Info Box: Control de Stock -->
            <div class="prod-info-box">
                <div class="prod-info-box-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="prod-info-box-body">
                    <div class="prod-info-box-title">Control de Stock</div>
                    <p class="prod-info-box-text">
                        Actualiza el <strong>stock mínimo</strong> para que el sistema te avise
                        cuando el inventario baje de ese límite.
                        Revisa también la <strong>cantidad actual</strong> si recibiste o usaste unidades recientemente.
                    </p>
                </div>
            </div>

            @{ var avisoHistorico = ViewData[LuxuryApp.Models.Fiscal.AvisoImpactoHistorico.CampoConfirmacion] as string; }
            @if (!string.IsNullOrEmpty(avisoHistorico))
            {
                @await Html.PartialAsync("_AvisoImpactoHistorico", avisoHistorico)
            }

            <!-- Acciones -->
            <div class="prod-form-actions">
                <button type="submit" class="prod-btn prod-btn--primary">
                    <i class="bi bi-floppy2-fill"></i>
                    Guardar Cambios
                </button>
                <a asp-action="Index" class="prod-btn prod-btn--secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
