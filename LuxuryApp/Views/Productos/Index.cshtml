@model LuxuryApp.Models.Productos.ProductoIndexViewModel
@using System.Globalization

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">

@{
    var ic = CultureInfo.InvariantCulture;
    const int StockBarMax = 20; // máximo visual para normalizar la barra de stock
}

<!-- Antiforgery oculto — requerido por toggleProducto() JS existente -->
<div id="productos-antiforgery" class="d-none">
    @Html.AntiForgeryToken()
</div>

<!-- ── CONTENEDOR PRINCIPAL ── -->
<div class="kpi-card prod-shell">

    <!-- ── A. HEADER ── -->
    <div class="prod-header">

        <div class="prod-header-left module-heading">
            <span class="module-eyebrow">Gestión de Productos</span>
            <h2 class="module-title"><i class="bi bi-box-seam-fill module-title-icon" aria-hidden="true"></i>Productos</h2>
            <p class="module-subtitle">Administra tu inventario y catálogo de productos.</p>
        </div>

        <div class="prod-kpi-grid">

            <div class="prod-kpi-chip">
                <span class="prod-kpi-label">Total Productos</span>
                <i class="bi bi-boxes prod-kpi-icon"></i>
                <span class="prod-kpi-num">@Model.TotalProductos</span>
                <span class="prod-kpi-sub">registrados</span>
            </div>

            <div class="prod-kpi-chip prod-kpi-chip--warn">
                <span class="prod-kpi-label">Bajo Stock</span>
                <i class="bi bi-exclamation-triangle prod-kpi-icon"></i>
                <span class="prod-kpi-num">@Model.ProductosBajoStock</span>
                <span class="prod-kpi-sub">requiere atención</span>
            </div>

            <div class="prod-kpi-chip prod-kpi-chip--success">
                <span class="prod-kpi-label">Valor Inventario</span>
                <i class="bi bi-currency-exchange prod-kpi-icon"></i>
                <span class="prod-kpi-num prod-kpi-num--currency">
                    <small class="prod-kpi-currency-sign">₡</small>
                    @Model.ValorInventario.ToString("N0")
                </span>
                <span class="prod-kpi-sub">valor actual</span>
            </div>

        </div>

    </div>

    <!-- ── B. BARRA DE ACCIONES ── -->
    <div class="prod-action-bar">

        <div class="prod-action-left">
            <a asp-action="Create" class="prod-btn prod-btn--primary">
                <i class="bi bi-plus-lg"></i>
                Nuevo Producto
            </a>
            <div class="prod-search-wrap">
                <i class="bi bi-search prod-search-icon" aria-hidden="true"></i>
                <input id="prodSearchInput"
                       type="search"
                       class="prod-search-input"
                       placeholder="Buscar producto..."
                       aria-label="Buscar producto" />
            </div>
        </div>

    </div>

    <!-- ── C. ALERTAS ── -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="prod-alert-wrap">
            <div class="prod-alert prod-alert--success">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["Mensaje"]
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="prod-alert-wrap">
            <div class="prod-alert prod-alert--danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @TempData["Error"]
            </div>
        </div>
    }

    <!-- ── D. TABLA DESKTOP (lg en adelante) ── -->
    <div class="prod-table-wrapper products-desktop-table d-none d-lg-block">
        <table class="prod-table" id="prodTable">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Productos.Any())
                {
                    foreach (var item in Model.Productos)
                    {
                        var stockPct = Math.Min((double)item.CantidadProducto / StockBarMax * 100, 100).ToString("F1", ic);
                        var isLow = item.CantidadProducto <= item.StockMinimo;

                        <tr class="prod-row" data-nombre="@item.NombreProducto.ToLowerInvariant()">

                            <!-- PRODUCTO: nombre + ID visual -->
                            <td>
                                <div class="prod-item-info">
                                    <span class="prod-name">@item.NombreProducto</span>

                                </div>
                            </td>

                            <!-- PRECIO -->
                            <td>
                                <span class="prod-price">
                                    <span class="prod-price-sign">₡</span>
                                    @item.PrecioProducto.ToString("N2")
                                </span>
                            </td>

                            <!-- STOCK + barra visual segmentada -->
                            <td>
                                <div class="prod-stock">
                                    <span class="prod-stock-num @(isLow ? "prod-stock-num--low" : "")">
                                        @item.CantidadProducto
                                        @if (isLow)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill prod-stock-warn-icon" aria-label="Bajo stock"></i>
                                        }
                                    </span>
                                    <div class="prod-stock-track">
                                        <div class="prod-stock-fill @(isLow ? "prod-stock-fill--warn" : "prod-stock-fill--ok")"
                                             style="width: @stockPct%"></div>
                                    </div>
                                </div>
                            </td>

                            <!-- ESTADO -->
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="prod-status prod-status--active">Activo</span>
                                }
                                else
                                {
                                    <span class="prod-status prod-status--inactive">Inactivo</span>
                                }
                            </td>

                            <!-- ACCIONES -->
                            <td>
                                <div class="prod-acts">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdProducto"
                                       class="prod-act-btn prod-act--edit"
                                       title="Editar @item.NombreProducto"
                                       aria-label="Editar @item.NombreProducto">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button"
                                            class="prod-act-btn @(item.Activo ? "prod-act--toggle-on" : "prod-act--toggle-off")"
                                            onclick="toggleProducto(@item.IdProducto)"
                                            title="@(item.Activo ? "Desactivar" : "Activar") @item.NombreProducto"
                                            aria-label="@(item.Activo ? "Desactivar" : "Activar") @item.NombreProducto">
                                        <i class="bi bi-@(item.Activo ? "toggle-on" : "toggle-off")"></i>
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="prod-empty">
                                <i class="bi bi-box-seam prod-empty-icon"></i>
                                <span class="prod-empty-text">No hay productos registrados</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Mensaje sin resultados de búsqueda (desktop) -->
        <div id="prodNoResultsDesk" class="prod-empty" style="display:none;">
            <i class="bi bi-search prod-empty-icon"></i>
            <span class="prod-empty-text">Sin resultados para tu búsqueda</span>
        </div>
    </div>

    <!-- ── E. CARDS MÓVIL (por debajo de lg) ── -->
    <div class="prod-mobile-list products-mobile-list d-lg-none" id="prodMobileList">
        @if (Model.Productos.Any())
        {
            foreach (var item in Model.Productos)
            {
                var stockPctM = Math.Min((double)item.CantidadProducto / StockBarMax * 100, 100).ToString("F1", ic);
                var isLowM = item.CantidadProducto <= item.StockMinimo;

                <div class="prod-mobile-card" data-nombre="@item.NombreProducto.ToLowerInvariant()">

                    <!-- Header: nombre + ID + acciones -->
                    <div class="prod-mobile-header">
                        <div class="prod-mobile-identity">
                            <span class="prod-name">@item.NombreProducto</span>

                        </div>
                        <div class="prod-mobile-top-acts">
                            <a asp-action="Edit"
                               asp-route-id="@item.IdProducto"
                               class="prod-act-btn prod-act--edit prod-mobile-act-btn"
                               title="Editar @item.NombreProducto"
                               aria-label="Editar @item.NombreProducto">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <button type="button"
                                    class="prod-act-btn @(item.Activo ? "prod-act--toggle-on" : "prod-act--toggle-off") prod-mobile-act-btn"
                                    onclick="toggleProducto(@item.IdProducto)"
                                    title="@(item.Activo ? "Desactivar" : "Activar") @item.NombreProducto"
                                    aria-label="@(item.Activo ? "Desactivar" : "Activar") @item.NombreProducto">
                                <i class="bi bi-@(item.Activo ? "toggle-on" : "toggle-off")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Meta: precio + estado -->
                    <div class="prod-mobile-meta">
                        <div class="prod-mobile-meta-item">
                            <span class="prod-mobile-label">
                                <i class="bi bi-tag"></i> Precio
                            </span>
                            <span class="prod-price">
                                <span class="prod-price-sign">₡</span>
                                @item.PrecioProducto.ToString("N2")
                            </span>
                        </div>
                        <div class="prod-mobile-meta-item">
                            <span class="prod-mobile-label">
                                <i class="bi bi-circle-fill prod-state-dot @(item.Activo ? "prod-state-dot--active" : "prod-state-dot--inactive")"></i>
                                Estado
                            </span>
                            @if (item.Activo)
                            {
                                <span class="prod-status prod-status--active">Activo</span>
                            }
                            else
                            {
                                <span class="prod-status prod-status--inactive">Inactivo</span>
                            }
                        </div>
                    </div>

                    <!-- Stock -->
                    <div class="prod-mobile-stock-row">
                        <div class="prod-mobile-stock-header">
                            <span class="prod-mobile-label">
                                <i class="bi bi-stack"></i> Stock
                            </span>
                            <span class="prod-stock-num @(isLowM ? "prod-stock-num--low" : "")">
                                @item.CantidadProducto
                                @if (isLowM)
                                {
                                    <i class="bi bi-exclamation-triangle-fill prod-stock-warn-icon" aria-label="Bajo stock"></i>
                                }
                            </span>
                        </div>
                        <div class="prod-stock-track prod-mobile-stock-track">
                            <div class="prod-stock-fill @(isLowM ? "prod-stock-fill--warn" : "prod-stock-fill--ok")"
                                 style="width: @stockPctM%"></div>
                        </div>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="prod-empty">
                <i class="bi bi-box-seam prod-empty-icon"></i>
                <span class="prod-empty-text">No hay productos registrados</span>
            </div>
        }

        <!-- Mensaje sin resultados de búsqueda (móvil) -->
        <div id="prodNoResultsMob" class="prod-empty" style="display:none;">
            <i class="bi bi-search prod-empty-icon"></i>
            <span class="prod-empty-text">Sin resultados para tu búsqueda</span>
        </div>
    </div>

</div>

<!-- ── JS: búsqueda client-side ── -->
<script>
(function () {
    'use strict';
    var input = document.getElementById('prodSearchInput');
    if (!input) return;

    input.addEventListener('input', function () {
        var q = (this.value || '').toLowerCase().trim();

        // Filtrar filas de tabla desktop
        var rows = document.querySelectorAll('#prodTable .prod-row');
        var visDesk = 0;
        rows.forEach(function (row) {
            var match = !q || (row.dataset.nombre || '').indexOf(q) !== -1;
            row.style.display = match ? '' : 'none';
            if (match) visDesk++;
        });
        var noDesk = document.getElementById('prodNoResultsDesk');
        if (noDesk) noDesk.style.display = (rows.length > 0 && visDesk === 0) ? '' : 'none';

        // Filtrar cards móvil
        var cards = document.querySelectorAll('#prodMobileList .prod-mobile-card');
        var visMob = 0;
        cards.forEach(function (card) {
            var match = !q || (card.dataset.nombre || '').indexOf(q) !== -1;
            card.style.display = match ? '' : 'none';
            if (match) visMob++;
        });
        var noMob = document.getElementById('prodNoResultsMob');
        if (noMob) noMob.style.display = (cards.length > 0 && visMob === 0) ? '' : 'none';
    });
}());
</script>
