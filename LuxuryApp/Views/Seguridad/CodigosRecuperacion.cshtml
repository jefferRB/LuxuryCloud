@model LuxuryApp.Models.Identity.CodigosRecuperacionViewModel
@using LuxuryApp.Services.Identity

@{
    ViewData["Title"] = "Códigos de recuperación";
    // Mismo criterio que Enrolar: el funcionario permanece en el chrome de su portal.
    var esPortalFuncionario = User.IsInRole(AppRoles.Funcionario) && !User.IsInRole(AppRoles.Administrador);
    Layout = esPortalFuncionario ? "~/Views/Shared/_FuncionarioLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";
}

<style>
    .mfa-card {
        max-width: 640px;
        margin: 40px auto;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.12);
        padding: 32px;
    }

    .recovery-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin: 20px 0;
    }

    .recovery-code {
        font-family: monospace;
        font-size: 1.05rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 14px;
        text-align: center;
        user-select: all;
    }
</style>

<div class="mfa-card">
    <h1 class="fs-4">Guarda tus códigos de recuperación</h1>

    <div class="alert alert-warning mt-3">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Esta es la única vez que verás estos códigos.</strong>
        Guárdalos fuera de este sistema (gestor de contraseñas o impresos). Cada código funciona
        una sola vez y es tu único acceso si pierdes el teléfono con la aplicación de autenticación.
    </div>

    <div class="recovery-grid">
        @foreach (var codigo in Model.Codigos)
        {
            <span class="recovery-code">@codigo</span>
        }
    </div>

    <a class="btn btn-primary" href="/">Listo, los guardé</a>
</div>
