@{
    Layout = "_PublicLayout";
    ViewData["FullTitle"] = "Eliminaci\u00f3n de Datos | LuxuryCloud";
    ViewData["MetaDescription"] = "Instrucciones para solicitar la eliminaci\u00f3n, correcci\u00f3n o revisi\u00f3n de datos asociados a LuxuryCloud.";
    ViewData["CanonicalUrl"] = "https://www.luxurycloud.app/eliminacion-datos";
    ViewData["PublicBodyClass"] = "public-static-page public-privacy-page public-data-deletion-page";

    var lastUpdated = "4 de junio de 2026";
}

<section class="privacy-page-section">
    <div class="container">
        <div class="privacy-intro-card" data-aos="fade-up">
            <span class="section-kicker">Cumplimiento y privacidad</span>
            <h1>Instrucciones para la eliminaci&oacute;n de datos</h1>
            <p>
                En LuxuryCloud respetamos las solicitudes de acceso, correcci&oacute;n, cancelaci&oacute;n, oposici&oacute;n y
                eliminaci&oacute;n de datos conforme corresponda.
            </p>

            <div class="privacy-meta">
                <span>Última actualizacion: @lastUpdated</span>
                <span>Canal oficial: <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a></span>
                <span>Ruta publica: <a class="privacy-link" href="/eliminacion-datos">/eliminacion-datos</a></span>
            </div>
        </div>

        <div class="privacy-summary-grid">
            <article class="privacy-summary-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">1</span>
                <h2>Qué puedes solicitar</h2>
                <p>
                    Atendemos solicitudes de eliminaci&oacute;n, correcci&oacute;n, consulta o revisi&oacute;n de datos personales
                    y datos operativos asociados al uso de LuxuryCloud, cuando corresponda.
                </p>
            </article>

            <article class="privacy-summary-card" data-aos="fade-up" data-aos-delay="80">
                <span class="privacy-section-number">2</span>
                <h2>Cómo iniciar la solicitud</h2>
                <p>
                    La solicitud debe enviarse a
                    <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a> con la
                    informaciónnecesaria para identificar la cuenta y el alcance del requerimiento.
                </p>
            </article>

            <article class="privacy-summary-card" data-aos="fade-up" data-aos-delay="120">
                <span class="privacy-section-number">3</span>
                <h2>Tiempo de respuesta</h2>
                <p>
                    LuxuryCloud revisara cada caso y respondera en un plazo razonable, normalmente dentro de 10 días
                    hábiles, salvo que la complejidad o la verificaciónrequieran mas tiempo.
                </p>
            </article>
        </div>

        <div class="privacy-grid">
            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">4</span>
                <h3>Que datos pueden solicitarse eliminar</h3>
                <p>
                    Se puede solicitar la eliminaci&oacute;n o revisi&oacute;n, cuando corresponda y segun aplique, de categorias
                    como las siguientes:
                </p>
                <ul class="privacy-list">
                    <li>Datos de cuenta.</li>
                    <li>Datos de contacto.</li>
                    <li>informacióndel negocio.</li>
                    <li>informaciónoperativa ingresada en la plataforma.</li>
                    <li>Datos relacionados con citas, clientes, servicios, funcionarios, productos, ingresos y egresos.</li>
                    <li>Datos de comunicaciones transaccionales.</li>
                    <li>Referencias de suscripcion o pago cuando aplique.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">5</span>
                <h3>Como solicitar la eliminacion</h3>
                <p>
                    La solicitud debe enviarse a
                    <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a>.
                </p>
                <p>El correo debe incluir, en la medida razonable aplicable:</p>
                <ul class="privacy-list">
                    <li>Nombre completo del solicitante.</li>
                    <li>Nombre del negocio o tenant, si aplica.</li>
                    <li>Correo asociado a la cuenta.</li>
                    <li>Numero de telefono asociado, si aplica.</li>
                    <li>Descripcion clara de la solicitud.</li>
                    <li>Indicar si solicita eliminacióntotal, parcial, correccion o consulta.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">6</span>
                <h3>Verificación de identidad o autorizacion</h3>
                <p>
                    Antes de procesar una solicitud, LuxuryCloud puede requerir informaciónrazonable para verificar la
                    identidad del solicitante, su representacion del negocio o su autorizaciónpara actuar en nombre de
                    la cuenta involucrada.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">7</span>
                <h3>Alcance y limitaciones</h3>
                <p>
                    La eliminaci&oacute;n o anonimizaci&oacute;n puede estar sujeta a limitaciones cuando sea necesario conservar
                    informaciónpor razones legitimas o legales, incluyendo:
                </p>
                <ul class="privacy-list">
                    <li>Obligaciones legales.</li>
                    <li>Seguridad.</li>
                    <li>Prevencion de fraude.</li>
                    <li>Auditoria.</li>
                    <li>Soporte.</li>
                    <li>Cumplimiento contractual.</li>
                    <li>Registros de facturacion o pagos.</li>
                    <li>Defensa de reclamos.</li>
                    <li>Datos necesarios para mantener la integridad del sistema.</li>
                </ul>
                <p class="privacy-note">
                    LuxuryCloud aplicara medidas razonables conforme corresponda, sin prometer eliminaciónabsoluta ni
                    inmediata en todos los escenarios.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">8</span>
                <h3>Datos de terceros ingresados por tenants</h3>
                <p>
                    Cuando un negocio usa LuxuryCloud para registrar datos de sus propios clientes, ese negocio es
                    responsable de atender las solicitudes de sus clientes finales. LuxuryCloud puede apoyar tecnicamente
                    al negocio cuando corresponda y segun el alcance del servicio aplicable.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">9</span>
                <h3>WhatsApp / Meta</h3>
                <p>
                    Si la solicitud esta relacionada con mensajes de WhatsApp enviados por LuxuryCloud mediante WhatsApp
                    Business Platform / Cloud API, se puede solicitar la revisi&oacute;n o eliminaci&oacute;n de datos internos
                    asociados al servicio cuando corresponda.
                </p>
                <p>
                    El uso de WhatsApp tambien puede estar sujeto a las politicas y condiciones de WhatsApp o Meta,
                    segun aplique.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">10</span>
                <h3>Tiempo de respuesta</h3>
                <p>
                    LuxuryCloud revisara la solicitud y respondera en un plazo razonable, normalmente dentro de 10 dias
                    habiles, salvo que la complejidad del caso o la verificaciónrequieran mas tiempo.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">11</span>
                <h3>Relacion con la Politica de Privacidad</h3>
                <p>
                    Estas instrucciones complementan la Politica de Privacidad de LuxuryCloud disponible en
                    <a class="privacy-link" href="/privacidad">/privacidad</a>.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">12</span>
                <h3>Contacto</h3>
                <p>
                    Para solicitudes relacionadas con acceso, correccion, cancelacion, oposicion, eliminacióno revision
                    de datos, escribe a <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a>.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">13</span>
                <h3>Última actualizacion</h3>
                <p>
                    Fecha de ultima actualizacion de estas instrucciones: <strong>@lastUpdated</strong>.
                </p>
            </article>
        </div>

        <div class="privacy-contact-card" data-aos="fade-up">
            <div>
                <span class="section-kicker">Canal oficial</span>
                <h2>Necesitas presentar una solicitud formal?</h2>
                <p>
                    Comparte la informaciónde tu cuenta, el alcance de la solicitud y cualquier dato que ayude a
                    verificar tu autorizaciónpara que podamos revisarla con medidas razonables.
                </p>
            </div>

            <div class="status-actions">
                <a class="btn public-btn public-btn-primary" href="mailto:info@luxurycloud.app">Enviar solicitud</a>
                <a class="btn public-btn public-btn-secondary" href="/privacidad">Ver politica</a>
            </div>
        </div>
    </div>
</section>
