                        <div class="lm-team-row"><div class="lm-team-avatar">JR</div><div class="lm-team-info"><strong>José Ruiz</strong><span>Barbero</span></div><span class="lm-team-pct">92%</span></div>
                        <div class="lm-team-row"><div class="lm-team-avatar">LS</div><div class="lm-team-info"><strong>Laura Soto</strong><span>Colorista</span></div><span class="lm-team-pct">78%</span></div>
                    </div>
