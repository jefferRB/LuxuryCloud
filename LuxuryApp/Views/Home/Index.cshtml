@model LuxuryApp.Models.Marketing.PublicHomeViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "LuxuryCloud | Software para barberías, salones y negocios de servicios en Costa Rica";
    ViewData["MetaDescription"] = "Programa para barberías, salones y negocios de servicios en Costa Rica: agenda, recordatorios por WhatsApp, reservas en línea, clientes, equipo, ingresos, egresos y estadísticas en una sola plataforma.";
    ViewData["CanonicalUrl"] = "https://luxurycloud.app/";
    ViewData["PublicBodyClass"] = "public-home-page";

    // Fuente de verdad de precios: el catálogo comercial (mismo calculador que /Billing/Planes,
    // planes LC_M_/LC_A_). NADA se hardcodea; sin catálogo, la sección muestra un mensaje neutro.
    var pricing = Model.Pricing;

    // Formato con separador de miles "." independiente de la cultura del hilo (es-CR).
    var crFormat = new System.Globalization.NumberFormatInfo
    {
        NumberGroupSeparator = ".",
        NumberDecimalDigits = 0
    };
    string FormatColones(decimal amount) => amount.ToString("N0", crFormat);
    string WorkersIncludedLabel(int workers) =>
        workers == 1 ? "1 integrante incluido" : $"{workers} integrantes incluidos";

    // "Desde ₡X" = plan mensual de UN integrante (LC_M_01), no un Min() sobre todos los planes.
    var startingPriceDisplay = pricing.IsAvailable ? FormatColones(pricing.StartingMonthlyCharge) : null;
    var whatsAppFromDisplay = pricing.WhatsAppFromCharge is > 0m
        ? FormatColones(pricing.WhatsAppFromCharge.Value)
        : null;

    var initialWorkers = pricing.MinWorkers > 0 ? pricing.MinWorkers : 1;
    var initialMonthlyTier = pricing.Tiers
        .FirstOrDefault(tier => tier.Cycle == "Monthly" && tier.Workers == initialWorkers);

    // Datos por (ciclo, integrantes) YA formateados en servidor, para que el JS solo cambie
    // texto y no duplique fórmulas ni formateo comercial.
    var tierData = pricing.Tiers
        .Select(tier => new
        {
            workers = tier.Workers,
            cycle = tier.Cycle,
            charge = FormatColones(tier.ChargeAmount),
            monthlyEq = FormatColones(tier.MonthlyEquivalentAmount),
            workersLabel = WorkersIncludedLabel(tier.Workers)
        })
        .ToArray();
    var tierDataJson = System.Text.Json.JsonSerializer.Serialize(tierData);

    // JSON-LD SoftwareApplication con offers.price SOLO desde el plan base comercial (LC_M_01).
    // Si no hay catálogo, se omite el bloque de precio (no se inventa).
    // Se usa un marcador "__AT__" para las claves JSON-LD (@context/@type) y se reemplaza al
    // final, evitando cualquier ambigüedad con la sintaxis de Razor dentro del bloque de código.
    var softwareApplicationLd = new Dictionary<string, object?>
    {
        ["__AT__context"] = "https://schema.org",
        ["__AT__type"] = "SoftwareApplication",
        ["name"] = "LuxuryCloud",
        ["applicationCategory"] = "BusinessApplication",
        ["operatingSystem"] = "Web",
        ["url"] = "https://luxurycloud.app/",
        ["description"] = "Software para barberías, salones y negocios de servicios: agenda, recordatorios por WhatsApp, reservas en línea, clientes, equipo, ingresos, egresos y estadísticas."
    };
    if (pricing.IsAvailable && pricing.StartingMonthlyCharge > 0m)
    {
        softwareApplicationLd["offers"] = new Dictionary<string, object?>
        {
            ["__AT__type"] = "Offer",
            ["price"] = pricing.StartingMonthlyCharge.ToString("0", System.Globalization.CultureInfo.InvariantCulture),
            ["priceCurrency"] = string.IsNullOrWhiteSpace(pricing.Currency) ? "CRC" : pricing.Currency,
            ["category"] = "Suscripción mensual"
        };
    }
    var softwareApplicationLdJson = System.Text.Json.JsonSerializer
        .Serialize(softwareApplicationLd)
        .Replace("__AT__", "@");

    // Video del fundador: opcional y configurable. Si no hay URL, se muestra el panel del
    // producto (representación fiel), nunca un reproductor vacío.
    var founderVideoUrl = Configuration["PublicSite:FounderVideoUrl"];
    var founderVideoPoster = Configuration["PublicSite:FounderVideoPosterUrl"];
    var hasFounderVideo = !string.IsNullOrWhiteSpace(founderVideoUrl);
}

@section Styles {
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LuxuryCloud" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content="LuxuryCloud | Software para barberías, salones y negocios de servicios" />
    <meta property="og:description" content="Agenda, recordatorios por WhatsApp, reservas en línea, clientes, equipo e indicadores del negocio en una sola plataforma creada en Costa Rica." />
    <meta property="og:url" content="https://luxurycloud.app/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LuxuryCloud | Software para barberías, salones y negocios de servicios" />
    <meta name="twitter:description" content="Ordene su agenda, sus clientes y su dinero en una sola plataforma creada en Costa Rica." />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "LuxuryCloud",
      "url": "https://luxurycloud.app/",
      "areaServed": "CR",
      "description": "Plataforma de gestión para barberías, salones y negocios de servicios en Costa Rica."
    }
    </script>
    <script type="application/ld+json">@Html.Raw(softwareApplicationLdJson)</script>
}

