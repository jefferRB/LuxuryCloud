@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Política de Privacidad";
    ViewData["MetaDescription"] = "Política de Privacidad de LuxuryCloud: tratamiento de datos, seguridad, WhatsApp, pagos, derechos ARCO y contacto.";
    ViewData["CanonicalUrl"] = "https://www.luxurycloud.app/privacidad";
    ViewData["PublicBodyClass"] = "public-static-page public-privacy-page";

    var lastUpdated = "3 de junio de 2026";
}

<section class="privacy-page-section">
    <div class="container">
        <div class="privacy-intro-card" data-aos="fade-up">
            <span class="section-kicker">Política publica</span>
            <h1>Política de Privacidad de LuxuryCloud</h1>
            <p>
                En LuxuryCloud tratamos datos personales y datos operativos de negocio para prestar una plataforma SaaS
                multi-tenant orientada a barberías, salones y negocios de servicios. Esta Política explica, en lenguaje
                claro, que datos tratamos, para que los usamos, con quien pueden compartirse y que opciones existen para
                ejercer derechos sobre dichos datos.
            </p>

            <div class="privacy-meta">
                <span>Ultima actualizacion: @lastUpdated</span>
                <span>Responsable: LuxuryCloud / LuxuryCompany</span>
                <span>Contacto: <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a></span>
            </div>
        </div>

        <div class="privacy-summary-grid">
            <article class="privacy-summary-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">1</span>
                <h2>Responsable del tratamiento</h2>
                <p>
                    LuxuryCloud, operado por LuxuryCompany, actua como proveedor de la plataforma y responsable del
                    tratamiento de los datos propios de la relacion comercial, soporte, seguridad, facturacion y
                    operación general del servicio.
                </p>
            </article>

            <article class="privacy-summary-card" data-aos="fade-up" data-aos-delay="80">
                <span class="privacy-section-number">2</span>
                <h2>Alcance de esta Política</h2>
                <p>
                    Aplica al sitio web, landing page, registro, uso de la plataforma, módulos internos, soporte,
                    suscripciónes, pagos y comunicaciones transaccionales, incluyendo mensajes por WhatsApp cuando
                    correspondan al servicio prestado.
                </p>
            </article>

            <article class="privacy-summary-card" data-aos="fade-up" data-aos-delay="120">
                <span class="privacy-section-number">3</span>
                <h2>Canal oficial de contacto</h2>
                <p>
                    Para consultas, solicitudes ARCO, soporte vinculado con privacidad o reportes sobre datos personales,
                    escribenos a <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a>.
                </p>
            </article>
        </div>

        <div class="privacy-grid">
            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">4</span>
                <h3>Servicios y canales cubiertos</h3>
                <p>
                    Esta Política aplica al tratamiento de datos realizado a traves de <strong>www.luxurycloud.app</strong>,
                    formularios de registro, procesos de autenticación, uso del SaaS, soporte técnico, integraciones
                    necesarias para operar el servicio y comunicaciones transaccionales relacionadas con citas, cuentas o pagos.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">5</span>
                <h3>Datos que recopilamos</h3>
                <ul class="privacy-list">
                    <li>Datos de identificacion como nombre, usuario, nombre comercial y datos basicos del negocio.</li>
                    <li>Datos de contacto como correo electronico, telefono y canales de comunicacion asociados.</li>
                    <li>Datos operativos cargados en la plataforma: clientes, citas, servicios, funcionarios, productos, agenda, ingresos, egresos y gestion del negocio.</li>
                    <li>Datos técnicos como dirección IP, fecha y hora, user agent, logs de seguridad y eventos de sesion.</li>
                    <li>Datos de suscripción y cobro, incluyendo estado del plan, referencias de pago, proveedor y montos, sin almacenar datos completos de tarjetas.</li>
                    <li>Datos de comunicaciones transaccionales, incluyendo recordatorios, confirmaciones, cancelaciones y estado de entrega cuando aplique.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">6</span>
                <h3>Finalidades del tratamiento</h3>
                <ul class="privacy-list">
                    <li>Operar el SaaS y mantener disponibles sus módulos y funciones.</li>
                    <li>Crear, administrar y proteger cuentas, usuarios y tenants.</li>
                    <li>Gestionar citas, clientes, servicios, personal, inventario y operación comercial.</li>
                    <li>Enviar recordatorios y confirmaciones de citas por canales habilitados.</li>
                    <li>Procesar suscripciónes y pagos mediante proveedores externos.</li>
                    <li>Brindar soporte técnico, auditoria, monitoreo y mejora operativa.</li>
                    <li>Cumplir obligaciones legales o contractuales y prevenir fraude, abuso o accesos no autorizados.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">7</span>
                <h3>WhatsApp Cloud API y Meta</h3>
                <p>
                    LuxuryCloud puede enviar mensajes transaccionales por WhatsApp relacionados con citas, confirmaciones,
                    cancelaciones y recordatorios a traves de WhatsApp Business Platform / Cloud API de Meta.
                </p>
                <ul class="privacy-list">
                    <li>Compartimos con Meta solo los datos razonablemente necesarios para entregar el mensaje.</li>
                    <li>Esto puede incluir numero de telefono, plantilla o contenido del mensaje, parametros de la cita y metadatos técnicos de entrega.</li>
                    <li>Los destinatarios pueden responder a flujos de confirmacion o cancelacion cuando la funcionalidad lo permita.</li>
                    <li>No utilizamos datos de WhatsApp para fines ajenos a la prestacion del servicio o a la comunicacion transaccional solicitada.</li>
                    <li>El uso de WhatsApp tambien puede estar sujeto a terminos y Políticas de Meta y WhatsApp.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">8</span>
                <h3>Base legal y consentimiento</h3>
                <p>
                    Tratamos datos personales conforme a la relacion contractual y a criterios razonables de cumplimiento
                    de la Ley N.&ordm; 8968 de Costa Rica, segun corresponda.
                </p>
                <ul class="privacy-list">
                    <li>Consentimiento del usuario o del titular cuando sea necesario.</li>
                    <li>Ejecucion del servicio contratado y administracion de la cuenta.</li>
                    <li>Interes legitimo en seguridad, continuidad operativa y prevencion de abuso.</li>
                    <li>Cumplimiento de obligaciones legales, regulatorias o de defensa de reclamaciones.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">9</span>
                <h3>Rol sobre los datos</h3>
                <p>
                    El cliente o tenant es responsable de los datos que ingresa en la plataforma sobre sus propios clientes,
                    citas, personal y operación. LuxuryCloud actua como proveedor SaaS y, segun corresponda, como encargado
                    o procesador respecto de esos datos.
                </p>
                <p class="privacy-note">
                    Cada cliente debe contar con base legitima y autorizacion suficiente para ingresar datos de terceros
                    en la plataforma y para activar comunicaciones como WhatsApp, correo u otros mensajes operativos.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">10</span>
                <h3>Encargados y proveedores</h3>
                <p>
                    Para prestar el servicio podemos apoyarnos en categorias de proveedores como:
                </p>
                <ul class="privacy-list">
                    <li>Hosting e infraestructura cloud.</li>
                    <li>Base de datos, almacenamiento y respaldo.</li>
                    <li>Servicios de comunicacion como WhatsApp Cloud API / Meta.</li>
                    <li>Pasarelas de pago externas, incluyendo Tilopay cuando aplique.</li>
                    <li>Servicios de correo, dominio, seguridad y observabilidad.</li>
                </ul>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">11</span>
                <h3>Pagos y suscripciónes</h3>
                <p>
                    LuxuryCloud no almacena datos completos de tarjetas de pago. Las transacciones son procesadas por
                    proveedores externos. Podemos conservar referencias de pago, estado de suscripción, fechas, montos,
                    codigos de proveedor y datos necesarios para soporte, auditoria y control comercial.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">12</span>
                <h3>Seguridad</h3>
                <p>
                    Aplicamos medidas razonables de seguridad tecnicas y organizativas, incluyendo autenticación,
                    controles de acceso, separacion por tenant, aislamiento de datos por tenant a nivel de aplicacion
                    y base de datos, mecanismos de auditoria y gestion segura de secretos mediante configuraciones
                    restringidas y variables de entorno cuando corresponde.
                </p>
                <p>
                    Tambien podemos utilizar controles equivalentes a row-level security o segregacion de datos para
                    limitar el acceso a la información del tenant correcto. Aun asi, ningun sistema es 100% invulnerable
                    y no podemos garantizar seguridad absoluta.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">13</span>
                <h3>Conservacion de datos</h3>
                <p>
                    Conservamos los datos mientras exista la cuenta, mientras sean necesarios para prestar el servicio,
                    mantener soporte, atender auditorias, cumplir obligaciones legales o defender reclamos. El cliente
                    puede solicitar cierre de cuenta, eliminacion o revision de retencion segun corresponda.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">14</span>
                <h3>Derechos de los titulares</h3>
                <p>
                    Las personas titulares de datos pueden solicitar, cuando aplique, el ejercicio de sus derechos de
                    acceso, rectificacion, cancelacion y oposicion (ARCO), asi como consultas razonables sobre el
                    tratamiento y solicitudes de eliminacion.
                </p>
                <p>
                    Para tramitar una solicitud, escribe a
                    <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a>.
                </p>
                <p class="privacy-note">
                    Las instrucciones publicas para solicitar eliminacion, correccion o revision de datos tambien estan
                    disponibles en <a class="privacy-link" href="/eliminacion-datos">/eliminacion-datos</a>.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">15</span>
                <h3>Transferencias internacionales</h3>
                <p>
                    Debido al uso de servicios cloud, plataformas de comunicacion, correo y otros proveedores, ciertos
                    datos pueden ser procesados fuera de Costa Rica. Cuando ello ocurra, procuramos contratar servicios
                    con medidas razonables de proteccion y bajo los terminos aplicables de dichos proveedores.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">16</span>
                <h3>Cookies y tecnologias similares</h3>
                <p>
                    El sitio y la plataforma pueden utilizar cookies o mecanismos técnicos equivalentes necesarios para
                    autenticación, mantenimiento de sesion, seguridad, preferencias basicas y funcionamiento del servicio.
                    Cuando existan integraciones adicionales, podran incorporarse tecnologias similares segun corresponda.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">17</span>
                <h3>Menores de edad</h3>
                <p>
                    LuxuryCloud esta dirigida a negocios y personas con capacidad para contratar o actuar en nombre de un
                    negocio. No esta orientada a menores de edad sin la autorizacion valida de su representante legal o
                    del negocio correspondiente.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">18</span>
                <h3>Cambios a esta Política</h3>
                <p>
                    Podemos actualizar esta Política para reflejar cambios operativos, legales, contractuales o de
                    producto. La version vigente se publicara en <a class="privacy-link" href="/privacidad">/privacidad</a>.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up" data-aos-delay="40">
                <span class="privacy-section-number">19</span>
                <h3>Contacto</h3>
                <p>
                    Si tienes preguntas sobre esta Política o sobre el tratamiento de datos en la plataforma, contactanos
                    en <a class="privacy-link" href="mailto:info@luxurycloud.app">info@luxurycloud.app</a>.
                </p>
            </article>

            <article class="privacy-section-card" data-aos="fade-up">
                <span class="privacy-section-number">20</span>
                <h3>Relacion con el contrato</h3>
                <p>
                    Esta Política de Privacidad complementa el Contrato de Uso del Servicio disponible en
                    <a class="privacy-link" href="/Contract">/Contract</a>. En caso de discrepancia operativa,
                    se interpretaran ambos documentos de forma coherente con la legislacion aplicable.
                </p>
            </article>
        </div>

        <div class="privacy-contact-card" data-aos="fade-up">
            <div>
                <span class="section-kicker">Soporte y cumplimiento</span>
                <h2>Necesitas hacer una consulta formal o revisar tu información?</h2>
                <p>
                    Podemos atender solicitudes relacionadas con privacidad, datos operativos, ARCO o contacto sobre
                    comunicaciones transaccionales desde nuestro canal oficial.
                </p>
            </div>

            <div class="status-actions">
                <a class="btn public-btn public-btn-primary" href="mailto:info@luxurycloud.app">Escribir a soporte</a>
                <a class="btn public-btn public-btn-secondary" href="/Contract">Ver contrato</a>
            </div>
        </div>
    </div>
</section>
