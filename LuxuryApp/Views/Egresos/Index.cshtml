@using LuxuryApp.Models.Finanzas
@model EgresoIndexViewModel

@{
    ViewData["Title"] = "Egresos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

<div class="finance-page-shell">

    <div class="finance-hero">
        <div class="finance-hero-left module-heading">
            <span class="module-eyebrow">Gestión de Egresos</span>
            <h1 class="module-title"><i class="bi bi-arrow-down-circle module-title-icon" aria-hidden="true"></i>Egresos</h1>
            <p class="module-subtitle">Administra tus salidas de dinero y su historial.</p>
        </div>

        <div class="finance-kpi-grid">
            <div class="finance-kpi-card">
                <div class="finance-kpi-icon finance-kpi-icon-violet">
                    <i class="bi bi-bag-dash"></i>
                </div>
                <div>
                    <span class="finance-kpi-label">Total egresos</span>
                    <span class="finance-kpi-value finance-kpi-value-violet">
                        ₡ @Model.TotalEgresos.ToString("N2")
                    </span>
                </div>
            </div>

            <div class="finance-kpi-card">
                <div class="finance-kpi-icon finance-kpi-icon-cyan">
                    <i class="bi bi-list-check"></i>
                </div>
                <div>
                    <span class="finance-kpi-label">Registros</span>
                    <span class="finance-kpi-value finance-kpi-value-cyan">
                        @Model.CantidadRegistros
                    </span>
                </div>
            </div>

        </div>
    </div>

    @{
        var egresoEfectivo = Model.Egresos.Where(e => "Efectivo".Equals(e.MetodoPago, StringComparison.OrdinalIgnoreCase)).Sum(e => e.Monto);
        var egresoTarjeta  = Model.Egresos.Where(e => "Tarjeta".Equals(e.MetodoPago,  StringComparison.OrdinalIgnoreCase)).Sum(e => e.Monto);
        var egresoSinpe    = Model.Egresos.Where(e => "Sinpe".Equals(e.MetodoPago,    StringComparison.OrdinalIgnoreCase)).Sum(e => e.Monto);
    }
    <div class="finance-secondary-kpis">
        <span class="finance-secondary-kpi">
            <span class="finance-secondary-kpi-label">Efectivo:</span>
            <span class="finance-secondary-kpi-value">₡ @egresoEfectivo.ToString("N2")</span>
        </span>
        <span class="finance-secondary-kpi">
            <span class="finance-secondary-kpi-label">Tarjeta:</span>
            <span class="finance-secondary-kpi-value">₡ @egresoTarjeta.ToString("N2")</span>
        </span>
        <span class="finance-secondary-kpi">
            <span class="finance-secondary-kpi-label">Sinpe:</span>
            <span class="finance-secondary-kpi-value">₡ @egresoSinpe.ToString("N2")</span>
        </span>
    </div>

    <div class="finance-actions">
        <a asp-action="Create" class="finance-btn-primary">
            <i class="bi bi-plus-lg"></i> Nuevo Egreso
        </a>

        <button type="button"
                class="finance-btn-secondary"
                data-bs-toggle="modal"
                data-bs-target="#modalCategorias"
                onclick="cargarCategorias()">
            <i class="bi bi-gear"></i> Gestionar Categorías
        </button>

        <button type="submit"
                form="formFiltros"
                formaction="@Url.Action("ExportarExcel")"
                class="finance-btn-excel">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </button>
    </div>

    <form method="get" id="formFiltros" class="finance-filters-panel">
        <div class="finance-filters-grid">

            <div class="finance-filter-group">
                <label class="finance-filter-label">
                    <i class="bi bi-calendar3"></i> Período
                </label>
                <select asp-for="Filtros.VistaTiempo"
                        class="finance-filter-select"
                        id="vistaTiempoSelect">
                    <option value="dia">Hoy</option>
                    <option value="semana">Semana</option>
                    <option value="mes">Mes</option>
                    <option value="anio">Año</option>
                    <option value="fechas">Rango de Fechas</option>
                    <option value="todo">Todo</option>
                </select>
                <div class="finance-date-range d-none" id="rangoFechasContainer">
                    <input asp-for="Filtros.FechaInicio" type="date" class="finance-filter-input" />
                    <input asp-for="Filtros.FechaFin"    type="date" class="finance-filter-input" />
                </div>
            </div>

            <div class="finance-filter-group">
                <label class="finance-filter-label">
                    <i class="bi bi-tag"></i> Categoría
                </label>
                <select asp-for="Filtros.CategoriaId"
                        asp-items="Model.Categorias"
                        class="finance-filter-select">
                    <option value="">Todas las categorías</option>
                </select>
            </div>

            <div class="finance-filter-group">
                <label class="finance-filter-label">
                    <i class="bi bi-credit-card"></i> Método de pago
                </label>
                <select asp-for="Filtros.MetodoPago"
                        asp-items="Model.MetodosPago"
                        class="finance-filter-select">
                    <option value="">Todos métodos</option>
                </select>
            </div>

        </div>
    </form>

    <div class="finance-table-desktop">
        <table class="finance-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Categoría</th>
                    <th>Detalle</th>
                    <th>Monto</th>
                    <th>Método Pago</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Egresos.Any())
                {
                    foreach (var egreso in Model.Egresos)
                    {
                        <tr>
                            <td>@egreso.FechaEgreso.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>
                                <span class="finance-method-badge">@egreso.CategoriaNombre</span>
                            </td>

                            <td>@egreso.Detalle</td>

                            <td class="finance-monto-expense">₡ @egreso.Monto.ToString("N2")</td>

                            <td><span class="finance-method-badge">@egreso.MetodoPago</span></td>

                            <td>
                                <div class="finance-actions-cell">
                                    <a asp-action="Edit"
                                       asp-route-id="@egreso.IdEgreso"
                                       class="finance-btn-row-edit">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>

                                    <button type="button"
                                            class="finance-btn-row-delete"
                                            data-egreso-id="@egreso.IdEgreso"
                                            data-categoria="@egreso.CategoriaNombre"
                                            data-detalle="@egreso.Detalle"
                                            data-monto="@egreso.Monto.ToString("N2")"
                                            data-metodo="@egreso.MetodoPago"
                                            data-fecha="@egreso.FechaEgreso.ToString("dd/MM/yyyy HH:mm")"
                                            onclick="abrirModalEliminacionEgreso(this)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="finance-empty-state">
                                <div class="finance-empty-icon">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <p class="finance-empty-title">No hay egresos registrados</p>
                                <p class="finance-empty-subtitle">Aún no se han registrado egresos en el rango seleccionado.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="finance-mobile-list">
        @if (Model.Egresos.Any())
        {
            foreach (var egreso in Model.Egresos)
            {
                <div class="finance-mobile-card">
                    <div class="finance-mobile-card-header">
                        <span class="finance-mobile-card-date">
                            <i class="bi bi-calendar3"></i>
                            @egreso.FechaEgreso.ToString("dd/MM/yyyy HH:mm")
                        </span>
                        <span class="finance-mobile-card-monto finance-mobile-card-monto-expense">
                            ₡ @egreso.Monto.ToString("N2")
                        </span>
                    </div>

                    <div class="finance-mobile-card-body">
                        <div class="finance-mobile-card-name">@egreso.CategoriaNombre</div>

                        <div class="finance-mobile-card-row">
                            <span class="finance-mobile-card-row-label">Detalle</span>
                            <span class="finance-mobile-card-row-value">@egreso.Detalle</span>
                        </div>

                        <div class="finance-mobile-card-row">
                            <span class="finance-mobile-card-row-label">Método</span>
                            <span class="finance-mobile-card-row-value">
                                <span class="finance-method-badge">@egreso.MetodoPago</span>
                            </span>
                        </div>
                    </div>

                    <div class="finance-mobile-card-footer">
                        <a asp-action="Edit"
                           asp-route-id="@egreso.IdEgreso"
                           class="finance-btn-row-edit">
                            <i class="bi bi-pencil"></i> Editar
                        </a>

                        <button type="button"
                                class="finance-btn-row-delete"
                                data-egreso-id="@egreso.IdEgreso"
                                data-categoria="@egreso.CategoriaNombre"
                                data-detalle="@egreso.Detalle"
                                data-monto="@egreso.Monto.ToString("N2")"
                                data-metodo="@egreso.MetodoPago"
                                data-fecha="@egreso.FechaEgreso.ToString("dd/MM/yyyy HH:mm")"
                                onclick="abrirModalEliminacionEgreso(this)">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="finance-empty-state">
                <div class="finance-empty-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <p class="finance-empty-title">No hay egresos registrados</p>
                <p class="finance-empty-subtitle">Aún no se han registrado egresos en el rango seleccionado.</p>
            </div>
        }
    </div>

</div>

<div class="modal fade finance-cat-modal" id="modalCategorias" tabindex="-1"
     aria-labelledby="lblModalCategorias" aria-modal="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3 flex-grow-1">
                    <div class="finance-cat-modal-icon">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <div class="finance-cat-modal-title-wrap">
                        <h5 class="finance-cat-modal-heading" id="lblModalCategorias">Gestionar Categorías</h5>
                        <p class="finance-cat-modal-subtitle">Administra las categorías disponibles para tus egresos.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="contenedorCategorias">
                <div class="text-center py-4" style="color:var(--private-muted-text);">
                    <i class="bi bi-arrow-repeat fs-4"></i>
                    <p class="mt-2 mb-0" style="font-size:0.875rem;">Cargando categorías…</p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── MODAL ELIMINAR EGRESO (listado) ── *@
<div class="modal fade finance-delete-modal" id="modalEliminarEgresoLista" tabindex="-1"
     aria-labelledby="lblEliminarEgresoLista" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="finance-delete-modal-title" id="lblEliminarEgresoLista">
                    <div class="finance-delete-modal-icon">
                        <i class="bi bi-trash3-fill"></i>
                    </div>
                    Eliminar Egreso
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="finance-delete-intro">
                    ¿Estás seguro que deseas eliminar este egreso? Esta acción no se puede deshacer.
                </p>
                <div class="finance-delete-summary">
                    <div class="finance-delete-summary-row">
                        <span class="finance-delete-summary-label">
                            <i class="bi bi-folder2"></i> Categoría
                        </span>
                        <span class="finance-delete-summary-value" id="delEgresoCategoria"></span>
                    </div>
                    <div class="finance-delete-summary-row">
                        <span class="finance-delete-summary-label">
                            <i class="bi bi-card-text"></i> Detalle
                        </span>
                        <span class="finance-delete-summary-value" id="delEgresoDetalle"></span>
                    </div>
                    <div class="finance-delete-summary-row">
                        <span class="finance-delete-summary-label">
                            <i class="bi bi-currency-exchange"></i> Monto
                        </span>
                        <span class="finance-delete-summary-value finance-monto-expense" id="delEgresoMonto"></span>
                    </div>
                    <div class="finance-delete-summary-row">
                        <span class="finance-delete-summary-label">
                            <i class="bi bi-credit-card"></i> Método de pago
                        </span>
                        <span class="finance-delete-summary-value" id="delEgresoMetodo"></span>
                    </div>
                    <div class="finance-delete-summary-row">
                        <span class="finance-delete-summary-label">
                            <i class="bi bi-calendar3"></i> Fecha
                        </span>
                        <span class="finance-delete-summary-value" id="delEgresoFecha"></span>
                    </div>
                </div>
                <div class="finance-delete-warning-box">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Esta acción es permanente. Se eliminará el egreso y se actualizarán los indicadores financieros y dashboards.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="finance-btn-back" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <form id="formEliminarEgresoLista" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="finance-btn-danger-form" id="btnConfirmarEliminarEgreso">
                        <i class="bi bi-trash3-fill"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalEliminacionEgreso(btn) {
            document.getElementById('delEgresoCategoria').textContent = btn.dataset.categoria;
            document.getElementById('delEgresoDetalle').textContent = btn.dataset.detalle;
            document.getElementById('delEgresoMonto').textContent = '₡ ' + btn.dataset.monto;
            document.getElementById('delEgresoMetodo').textContent = btn.dataset.metodo;
            document.getElementById('delEgresoFecha').textContent = btn.dataset.fecha;
            document.getElementById('formEliminarEgresoLista').action = '@Url.Action("Delete", "Egresos")/' + btn.dataset.egresoId;
            var btnConf = document.getElementById('btnConfirmarEliminarEgreso');
            btnConf.disabled = false;
            btnConf.innerHTML = '<i class="bi bi-trash3-fill"></i> Eliminar';
            new bootstrap.Modal(document.getElementById('modalEliminarEgresoLista')).show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var formEliminar = document.getElementById('formEliminarEgresoLista');
            if (formEliminar) {
                formEliminar.addEventListener('submit', function () {
                    var btn = document.getElementById('btnConfirmarEliminarEgreso');
                    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Eliminando…'; }
                });
            }
        });

        function toggleRangoFechas() {
            var select = document.getElementById("vistaTiempoSelect");
            var container = document.getElementById("rangoFechasContainer");
            if (select.value === "fechas") {
                container.classList.remove("d-none");
            } else {
                container.classList.add("d-none");
            }
        }

        function enviarFiltros() {
            document.getElementById("formFiltros").submit();
        }

        document.addEventListener("DOMContentLoaded", function () {
            var vistaTiempo = document.getElementById("vistaTiempoSelect");
            var categoria   = document.querySelector("[name='Filtros.CategoriaId']");
            var metodo      = document.querySelector("[name='Filtros.MetodoPago']");
            var fechaInicio = document.querySelector("[name='Filtros.FechaInicio']");
            var fechaFin    = document.querySelector("[name='Filtros.FechaFin']");

            toggleRangoFechas();

            vistaTiempo.addEventListener("change", function () {
                toggleRangoFechas();
                enviarFiltros();
            });

            categoria.addEventListener("change",   enviarFiltros);
            metodo.addEventListener("change",      enviarFiltros);
            fechaInicio.addEventListener("change", enviarFiltros);
            fechaFin.addEventListener("change",    enviarFiltros);
        });
    </script>
}
