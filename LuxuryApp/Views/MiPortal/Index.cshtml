@model LuxuryApp.Models.Funcionarios.MiPanelViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mi Portal";
    ViewData["PortalActive"] = "panel";
    var cr = new CultureInfo("es-CR");
    string Money(decimal v) => "₡" + v.ToString("#,##0.00", cr);
    ViewData["CobroRetorno"] = "panel";
}

@{
    var citasHoy = Model.KpisHoy.CitasHoy;
    var pendHoy = Model.KpisHoy.PendientesHoy;
}

<!-- HERO DE BIENVENIDA -->
<div class="lp-hero">
    <h1>Hola, @Model.Nombre 👋</h1>
    <p class="lp-hero-sub">Este es tu portal de trabajo: citas, cobros, ganancias y pagos en un solo lugar.</p>
    <p class="lp-hero-date">@Model.Hoy.ToString("dddd, dd 'de' MMMM 'de' yyyy", cr)</p>
    <div class="lp-hero-chips">
        <span class="lp-hero-chip"><i class="bi bi-calendar-check"></i> <b>@citasHoy</b> cita@(citasHoy == 1 ? "" : "s") hoy</span>
        <span class="lp-hero-chip"><i class="bi bi-hourglass-split"></i> <b>@pendHoy</b> pendiente@(pendHoy == 1 ? "" : "s") de cobro</span>
        <span class="lp-hero-chip"><i class="bi bi-scissors"></i> <b>@Money(Model.ResumenHoy.ProduccionTotal)</b> producción</span>
    </div>
</div>

<!-- RESUMEN DE HOY -->
<h2 class="lp-section-title"><i class="bi bi-sun"></i> Resumen de hoy</h2>
<div class="lp-metrics">
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-blue"><i class="bi bi-calendar-check"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Citas de hoy</span>
            <span class="lp-metric-value">@citasHoy</span>
            <span class="lp-metric-sub">@pendHoy pendiente@(pendHoy == 1 ? "" : "s")</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-green"><i class="bi bi-scissors"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Producción de hoy</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.ResumenHoy.ProduccionTotal)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-violet"><i class="bi bi-graph-up-arrow"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Comisión estimada hoy</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.ResumenHoy.TotalEstimado)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-amber"><i class="bi bi-hourglass-split"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Pendiente de cobrar</span>
            <span class="lp-metric-value lp-metric-value--amber">@Money(Model.KpisHoy.PendienteCobrarHoy)</span>
        </div>
    </div>
</div>

<!-- CITAS DE HOY -->
<div class="lp-card" style="margin-bottom:1rem;">
    <h2 class="lp-section-title"><i class="bi bi-calendar-check"></i> Citas de hoy</h2>
    @if (Model.CitasHoy.Count == 0)
    {
        <div class="lp-empty">
            <div class="lp-empty-ic"><i class="bi bi-calendar-x"></i></div>
            <div class="lp-empty-title">No tienes citas para hoy</div>
            <p class="lp-empty-text">Cuando agendes o te asignen citas para hoy aparecerán aquí.</p>
        </div>
    }
    else
    {
        ViewData["PuedeRegistrarCobros"] = Model.PuedeRegistrarCobros;
        <div class="lp-list">
            @foreach (var cita in Model.CitasHoy)
            {
                <partial name="_PortalCitaRow" model="cita" />
            }
        </div>
    }
</div>

@{ ViewData["PuedeRegistrarCobros"] = false; }

<!-- PRÓXIMAS CITAS -->
<div class="lp-card" style="margin-bottom:1rem;">
    <h2 class="lp-section-title"><i class="bi bi-calendar3"></i> Próximas citas</h2>
    @if (Model.ProximasCitas.Count == 0)
    {
        <div class="lp-empty">
            <div class="lp-empty-ic"><i class="bi bi-calendar3"></i></div>
            <div class="lp-empty-title">Sin próximas citas</div>
            <p class="lp-empty-text">No tienes próximas citas registradas por el momento.</p>
        </div>
    }
    else
    {
        <div class="lp-list">
            @foreach (var cita in Model.ProximasCitas)
            {
                <partial name="_PortalCitaRow" model="cita" />
            }
        </div>
    }
</div>

<!-- RESUMEN DE LA SEMANA -->
<h2 class="lp-section-title"><i class="bi bi-calendar-week"></i> Esta semana</h2>
<p class="lp-muted" style="margin-top:-.4rem;">
    @Model.InicioSemana.ToString("dd/MM", cr) al @Model.FinSemana.ToString("dd/MM", cr)
</p>
<div class="lp-metrics">
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-green"><i class="bi bi-scissors"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Producción</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.ProduccionSemana)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-violet"><i class="bi bi-graph-up-arrow"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Comisión estimada</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.ComisionSemana)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-blue"><i class="bi bi-wallet2"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Pagado</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.PagadoSemana)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-amber"><i class="bi bi-hourglass-split"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Pendiente</span>
            <span class="lp-metric-value lp-metric-value--amber">@Money(Model.PendienteSemana)</span>
        </div>
    </div>
</div>

@if (Model.PuedeRegistrarCobros)
{
    <partial name="_PortalCobroModal" />
}
