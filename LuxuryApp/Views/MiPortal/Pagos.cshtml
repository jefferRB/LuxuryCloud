@model LuxuryApp.Models.Funcionarios.MisPagosViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mis Pagos";
    ViewData["PortalActive"] = "pagos";
    var cr = new CultureInfo("es-CR");
    string Money(decimal v) => "₡" + v.ToString("#,##0.00", cr);
}

<div class="lp-hero">
    <h1>Mis pagos recibidos</h1>
    <p class="lp-hero-sub">Historial de pagos registrados por tu negocio.</p>
</div>

<div class="lp-metrics">
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-green"><i class="bi bi-wallet2"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Total recibido histórico</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.TotalPagadoHistorico)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-blue"><i class="bi bi-calendar-month"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Recibido este mes</span>
            <span class="lp-metric-value lp-metric-value--green">@Money(Model.RecibidoMes)</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-violet"><i class="bi bi-clock-history"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Último pago</span>
            <span class="lp-metric-value" style="font-size:1.1rem;">@(Model.UltimoPago?.ToString("dd/MM/yyyy", cr) ?? "—")</span>
        </div>
    </div>
    <div class="lp-metric">
        <div class="lp-metric-ic lp-ic-cyan"><i class="bi bi-receipt"></i></div>
        <div class="lp-metric-body">
            <span class="lp-metric-label">Pagos registrados</span>
            <span class="lp-metric-value">@Model.PagosRegistrados</span>
        </div>
    </div>
</div>

<div class="lp-card">
    <h2 class="lp-section-title"><i class="bi bi-cash-stack"></i> Historial</h2>
    @if (Model.Pagos.Count == 0)
    {
        <div class="lp-empty">
            <div class="lp-empty-ic"><i class="bi bi-wallet2"></i></div>
            <div class="lp-empty-title">Aún no tienes pagos registrados</div>
            <p class="lp-empty-text">Cuando tu negocio te registre un pago aparecerá aquí.</p>
        </div>
    }
    else
    {
        <div class="lp-list">
            @foreach (var pago in Model.Pagos)
            {
                <div class="lp-row">
                    <div class="lp-row-ic lp-ic-green"><i class="bi bi-check2"></i></div>
                    <div class="lp-row-main">
                        <div class="lp-row-title">Semana @pago.InicioSemana.ToString("dd/MM", cr) – @pago.FinSemana.ToString("dd/MM", cr)</div>
                        <div class="lp-row-meta">
                            <span><i class="bi bi-calendar3"></i> Pagado el @pago.FechaPago.ToString("dd/MM/yyyy", cr)</span>
                            @if (!string.IsNullOrWhiteSpace(pago.MetodoPago))
                            {
                                <span><i class="bi bi-wallet2"></i> @pago.MetodoPago</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                        {
                            <div class="lp-row-meta" style="font-style:italic;"><span><i class="bi bi-chat-left-text"></i> @pago.Observacion</span></div>
                        }
                    </div>
                    <div class="lp-row-right">
                        <span class="lp-row-amount lp-row-amount--green">@Money(pago.Monto)</span>
                    </div>
                </div>
            }
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;gap:.5rem;flex-wrap:wrap;">
            <span class="lp-muted" style="font-size:.8rem;">
                Mostrando @Model.DesdeRegistro a @Model.HastaRegistro de @Model.TotalRegistros pagos
            </span>
            @if (Model.TotalPaginas > 1)
            {
                <div style="display:flex;gap:.5rem;align-items:center;">
                    @if (Model.Pagina > 1)
                    {
                        <a href="/MiPortal/Pagos?pagina=@(Model.Pagina - 1)" class="lp-btn lp-btn--ghost"><i class="bi bi-chevron-left"></i></a>
                    }
                    <span class="lp-muted" style="font-size:.8rem;">@Model.Pagina / @Model.TotalPaginas</span>
                    @if (Model.HayMas)
                    {
                        <a href="/MiPortal/Pagos?pagina=@(Model.Pagina + 1)" class="lp-btn lp-btn--ghost"><i class="bi bi-chevron-right"></i></a>
                    }
                </div>
            }
        </div>
    }
</div>
